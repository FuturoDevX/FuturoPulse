<%- include('partials/header', { title: 'Operations Overview' }) %>
<%
  function occClass(p){ return p >= 85 ? 'good' : p >= 70 ? 'warn' : 'bad'; }
  const shortName = (n) => n.replace('Futuro Childcare & Education - ','');
  const money = (n) => '$' + Number(n||0).toLocaleString('en-AU', { maximumFractionDigits: 0 });
  const rangeQS = `from=${from}&to=${to}`;
%>

<div class="page-head">
  <div>
    <h1>Operations Overview</h1>
    <p class="sub">All centres · <%= from %> → <%= to %></p>
  </div>
  <div class="head-actions">
    <% if (['admin','ops_manager'].includes(user.role)) { %>
      <form method="POST" action="/admin/refresh" class="inline">
        <button type="submit" class="secondary-btn">↻ Refresh data</button>
      </form>
    <% } %>
  </div>
</div>

<%- include('partials/rangebar', { action: '/', from, to, presets, fwdPresets }) %>

<div class="grid kpis">
  <div class="card stat"><div class="n <%= occClass(totals.occupancy) %>-text"><%= totals.occupancy %>%</div><div class="l">Avg occupancy</div></div>
  <div class="card stat"><div class="n"><%= totals.attendance_rate %>%</div><div class="l">Attendance rate</div></div>
  <div class="card stat"><div class="n"><%= totals.booked.toLocaleString('en-AU') %></div><div class="l">Booked child-days</div></div>
  <div class="card stat"><div class="n"><%= money(totals.fee_total) %></div><div class="l">Fees billed</div></div>
  <div class="card stat"><div class="n"><%= totals.casual.toLocaleString('en-AU') %></div><div class="l">Casual days</div></div>
  <div class="card stat"><div class="n"><%= totals.capacity %></div><div class="l">Total places</div></div>
</div>

<%
  // Minimal, safe Markdown -> HTML for the AI briefing (headings, bullets, bold/italic).
  function _esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function _mdInline(s){ return _esc(s).replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>').replace(/(^|[^*])\*(?!\*)(.+?)\*/g,'$1<em>$2</em>'); }
  function mdToHtml(md){
    const lines = String(md||'').split(/\r?\n/); let out=''; let inList=false;
    for (const raw of lines){ const line = raw.trim();
      if(!line){ if(inList){out+='</ul>';inList=false;} continue; }
      const b = line.match(/^[-*]\s+(.*)$/); const h = line.match(/^(#{1,3})\s+(.*)$/);
      if(b){ if(!inList){out+='<ul>';inList=true;} out+='<li>'+_mdInline(b[1])+'</li>'; continue; }
      if(inList){out+='</ul>';inList=false;}
      if(h){ const lvl=Math.min(h[1].length+2,5); out+='<h'+lvl+'>'+_mdInline(h[2])+'</h'+lvl+'>'; }
      else out+='<p>'+_mdInline(line)+'</p>';
    }
    if(inList)out+='</ul>'; return out;
  }
  const canGenerate = ['admin','ops_manager'].includes(user.role);
%>
<div class="card ai-brief" id="briefing">
  <div class="pc-head" style="margin-bottom:6px;">
    <div>
      <div class="pcm-name" style="display:flex;align-items:center;gap:8px;">✨ AI weekly briefing
        <% if (typeof aiEnabled !== 'undefined' && aiEnabled && briefing) { %><span class="badge <%= briefingCurrent ? 'role-admin' : '' %>" style="font-size:10px;"><%= briefingCurrent ? 'Current' : 'Older week' %></span><% } %>
      </div>
      <div class="pcm-cad">Written by Claude from this week’s operations data<% if (briefing) { %> · week ending <%= briefing.period_to %> · generated <%= (briefing.created_at||'').slice(0,16) %><% } %></div>
    </div>
    <% if (canGenerate && (typeof aiEnabled==='undefined' || aiEnabled)) { %>
      <form method="POST" action="/ai/briefing" class="inline" onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent='Generating…';">
        <button type="submit" class="secondary-btn"><%= briefing ? '↻ Refresh' : '✨ Generate' %></button>
      </form>
    <% } %>
  </div>
  <% if (typeof briefingError !== 'undefined' && briefingError) { %><div class="flash bad" style="margin:8px 0;"><%= briefingError %></div><% } %>
  <% if (briefing) { %>
    <div class="brief-body"><%- mdToHtml(briefing.content) %></div>
    <% if (!briefingCurrent && (typeof aiEnabled==='undefined' || aiEnabled)) { %><p class="pcm-cad" style="margin-top:8px;">Newer data is available — Refresh to rewrite for the latest week.</p><% } %>
  <% } else if (typeof aiEnabled !== 'undefined' && !aiEnabled) { %>
    <p class="sub" style="margin:6px 0 0;">Set an <code>ANTHROPIC_API_KEY</code> environment variable (and optionally <code>AI_MODEL</code>) to enable this. It calls the Claude API server-side to summarise the week — what moved and what to watch — across all centres.</p>
  <% } else { %>
    <p class="sub" style="margin:6px 0 0;"><%= canGenerate ? 'No briefing yet — hit Generate to have Claude summarise the week.' : 'No briefing yet.' %></p>
  <% } %>
</div>

<% if (typeof pcGroup !== 'undefined' && pcGroup) {
     const t = pcGroup.targets || {};
     const mlab = (mm)=>{ if(!mm) return ''; const [y,mo]=mm.split('-'); return new Date(y,mo-1,1).toLocaleDateString('en-AU',{month:'short',year:'2-digit'}); };
     const pf = (v,target,better)=>{ if(v==null||target==null) return ''; const ok = better==='low' ? v<=target : v>=target; return ok?'good-text':'bad-text'; };
     const pv = (v,suf='')=> v==null?'—':v+suf;
%>
<div class="card">
  <div class="pc-head">
    <h2 style="margin:0;">People &amp; experience <span class="muted" style="font-weight:400;font-size:13px;">· group average · <%= mlab(pcGroup.month) %></span></h2>
    <a class="row-link" href="/pc">People &amp; Culture detail →</a>
  </div>
  <div class="grid kpis" style="margin-top:14px;">
    <div class="card stat"><div class="n <%= pf(pcGroup.enps,t.enps,'high') %>"><%= pv(pcGroup.enps) %></div><div class="l">eNPS<% if(t.enps!=null){ %> · ≥<%= t.enps %><% } %></div></div>
    <div class="card stat"><div class="n <%= pf(pcGroup.family_nps,t.family_nps,'high') %>"><%= pv(pcGroup.family_nps) %></div><div class="l">Family NPS<% if(t.family_nps!=null){ %> · ≥<%= t.family_nps %><% } %></div></div>
    <div class="card stat"><div class="n <%= pf(pcGroup.turnover,t.turnover,'low') %>"><%= pv(pcGroup.turnover,'%') %></div><div class="l">Turnover<% if(t.turnover!=null){ %> · ≤<%= t.turnover %>%<% } %></div></div>
    <div class="card stat"><div class="n <%= pf(pcGroup.checkin_pct,t.checkin_pct,'high') %>"><%= pv(pcGroup.checkin_pct,'%') %></div><div class="l">Career check-ins</div></div>
    <div class="card stat"><div class="n <%= pf(pcGroup.psych_safety,t.psych_safety,'high') %>"><%= pv(pcGroup.psych_safety) %></div><div class="l">Psych safety</div></div>
  </div>
</div>
<% } %>

<% if (typeof occTrend !== 'undefined' && occTrend && occTrend.length > 1) {
     const mLbl = function(m){ var p=m.split('-'); return new Date(p[0],p[1]-1,1).toLocaleDateString('en-AU',{month:'short',year:'2-digit'}); };
     const oLbls = occTrend.map(function(t){ return mLbl(t.month); });
     const firstProj = occTrend.findIndex(function(t){ return t.projected; });
     const oDash = firstProj > 0 ? firstProj - 1 : (firstProj === 0 ? 0 : null); // dash from last actual → projected
     const occLc = { labels:oLbls, height:180, suf:'%', dashFrom: (oDash!=null?oDash:null), series:[
       { name:'Occupancy', points: occTrend.map(function(t){return t.occupancy;}) },
       { name:'Attendance', points: occTrend.map(function(t){return t.attendance_rate;}) },
     ]};
     // Revenue: complete months only (a partial/scheduled month understates a monthly $ sum).
     const revMonths = occTrend.filter(function(t){ return !t.projected; });
     const revLc = { labels: revMonths.map(function(t){return mLbl(t.month);}), height:170, money:true, series:[ { name:'Fees billed', points: revMonths.map(function(t){return t.fee_total;}) } ]};
%>
<div class="card">
  <div class="pc-head"><h2 style="margin:0;">Group trends <span class="muted" style="font-weight:400;font-size:13px;">· monthly</span></h2><a class="row-link" href="/compare">Compare centres →</a></div>
  <h3 class="card-sub">Occupancy &amp; attendance % <span class="muted" style="font-weight:400;font-size:12px;">· dashed = projected from scheduled bookings</span></h3>
  <%- include('partials/linechart', { lc: occLc }) %>
  <h3 class="card-sub">Fees billed (revenue) <span class="muted" style="font-weight:400;font-size:12px;">· complete months</span></h3>
  <%- include('partials/linechart', { lc: revLc }) %>
</div>
<% } %>

<div class="card">
  <h2 style="margin-top:0;">By centre</h2>
  <div style="overflow-x:auto;">
  <table>
    <thead>
      <tr>
        <th>Centre</th><th>Places</th><th class="num">Avg/day</th>
        <th style="width:160px;">Occupancy</th>
        <th class="num" title="Projected occupancy over the next 30 days from scheduled bookings">Fcast 30d</th>
        <th class="num">Attend.</th>
        <th class="num">Casual</th><th class="num">Fees billed</th>
        <th class="num" title="Families on the LineLeader waitlist">Waitlist</th>
        <th class="num" title="Upcoming expected starts (LineLeader)">Upcoming</th><th></th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(function(r){ %>
        <tr>
          <td><a class="row-link" href="/centre/<%= r.owna_id %>?<%= rangeQS %>"><%= shortName(r.name) %></a></td>
          <td><%= r.capacity %></td>
          <td class="num"><%= r.avg_daily_booked %></td>
          <td>
            <div class="bar-wrap" title="<%= r.booked %> booked child-days">
              <div class="bar <%= occClass(r.occupancy) %>" style="width:<%= Math.min(r.occupancy,100) %>%;"></div>
              <span class="bar-val"><%= r.occupancy %>%</span>
            </div>
          </td>
          <% var f = fcast[r.owna_id]; %>
          <td class="num"><% if (f && f.days) { %><span class="<%= occClass(f.occupancy) %>-text" style="font-weight:600;"><%= f.occupancy %>%</span><% } else { %><span class="muted">—</span><% } %></td>
          <td class="num"><%= r.attendance_rate %>%</td>
          <td class="num"><%= r.casual %></td>
          <td class="num"><%= money(r.fee_total) %></td>
          <% var ll = llMap[r.owna_id]; %>
          <td class="num <%= ll && ll.waitlist>0 ? 'hot' : '' %>"><%= ll ? ll.waitlist : '—' %></td>
          <td class="num"><%= ll ? ll.starts_future : '—' %></td>
          <td class="num"><a class="row-link" href="/centre/<%= r.owna_id %>?<%= rangeQS %>">Details →</a></td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <% var llTotWait=0, llTotUp=0; Object.values(llMap).forEach(function(x){llTotWait+=x.waitlist;llTotUp+=x.starts_future;});
         var fB=0, fCD=0; rows.forEach(function(r){ var f=fcast[r.owna_id]; if(f&&f.days){ fB+=f.booked; fCD+=r.capacity*f.days; } });
         var fcastAll = fCD ? Math.round(fB/fCD*1000)/10 : 0; %>
      <tr class="total-row">
        <td>All centres</td><td><%= totals.capacity %></td><td class="num">—</td>
        <td><div class="bar-wrap"><div class="bar <%= occClass(totals.occupancy) %>" style="width:<%= Math.min(totals.occupancy,100) %>%;"></div><span class="bar-val"><%= totals.occupancy %>%</span></div></td>
        <td class="num"><span class="<%= occClass(fcastAll) %>-text"><%= fcastAll %>%</span></td>
        <td class="num"><%= totals.attendance_rate %>%</td>
        <td class="num"><%= totals.casual %></td>
        <td class="num"><%= money(totals.fee_total) %></td>
        <td class="num"><%= llTotWait %></td>
        <td class="num"><%= llTotUp %></td><td></td>
      </tr>
    </tfoot>
  </table>
  </div>
</div>

<p class="footnote">
  Occupancy = booked child-days ÷ (places × days). Fees billed = sum of session fees (gross, before CCS subsidy).
  <% if (lastRun) { %>· Data as at <%= lastRun.finished_at || lastRun.started_at %> (<%= lastRun.status %>)<% } else { %>· No snapshot yet — click “Refresh from OWNA”.<% } %>
</p>

<%- include('partials/footer') %>
