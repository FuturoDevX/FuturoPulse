<%- include('partials/header', { title: 'Operations Overview' }) %>
<%
  function occClass(p){ return p >= 85 ? 'good' : p >= 70 ? 'warn' : 'bad'; }
  const shortName = (n) => n.replace('Futuro Childcare & Education - ','');
  const money = (n) => '$' + Number(n||0).toLocaleString('en-AU', { maximumFractionDigits: 0 });
  const rangeQS = `from=${from}&to=${to}`;
%>

<div class="page-head">
  <div>
    <h1>Operations Overview</h1>
    <p class="sub">All centres · <%= from %> → <%= to %></p>
  </div>
  <div class="head-actions">
    <% if (['admin','ops_manager'].includes(user.role)) { %>
      <form method="POST" action="/admin/refresh" class="inline">
        <button type="submit" class="secondary-btn">↻ Refresh data</button>
      </form>
    <% } %>
  </div>
</div>

<%- include('partials/rangebar', { action: '/', from, to, presets, fwdPresets }) %>

<%
  // Honest labels: when the range runs past today, tiles built from booked-ahead rows say so.
  const aheadCap = 'booked ahead — departures not yet deducted, so this overstates';
  const seatsRow = locals.scopedOwnaId ? (seats.byOwna[locals.scopedOwnaId] || null) : seats.group;
  const utilRow = locals.scopedOwnaId ? (util.byOwna[locals.scopedOwnaId] || null) : util.group;
  const dLbl = (d) => new Date(d + 'T00:00:00').toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
  const yearQS = (k) => `/?${rangeQS}&year=${k}`;
  const plural = (n, w) => n + ' ' + w + (n === 1 ? '' : 's');

  // Tile badge icons. Small, stroked, one weight, drawn inline — no icon font, nothing fetched, no
  // emoji. The sidebar's own set lives in views/partials/header.ejs; an EJS include does not hand its
  // scope back to the parent, so these four are declared here rather than reached for. If a third page
  // wants badges, move both sets into one partial instead of writing a third copy.
  const TILE_ICONS = {
    occupancy:  '<path d="M4.2 16.9a9 9 0 1 1 15.6 0"/><path d="m12 13.4 3.9-3.6"/><circle cx="12" cy="16.9" r="1"/>',
    attendance: '<circle cx="9.6" cy="7.8" r="3.4"/><path d="M3.6 19.6a6 6 0 0 1 9.6-4.8"/><path d="m14.8 17.6 2 2 3.8-4.2"/>',
    year:       '<rect x="3.4" y="5" width="17.2" height="15.4" rx="2.1"/><path d="M3.4 10h17.2M8.4 3.2v3.6M15.6 3.2v3.6"/>',
    fees:       '<path d="M12 3v18"/><path d="M16.2 7.4c-.5-1.5-2.1-2.5-4.2-2.5-2.5 0-4.2 1.2-4.2 3 0 4.3 8.7 1.9 8.7 6.4 0 1.9-1.8 3.2-4.5 3.2-2.5 0-4.3-1-4.8-2.8"/>',
    sparkle:    '<path d="M11 3.2 12.8 8 17.6 9.8 12.8 11.6 11 16.4 9.2 11.6 4.4 9.8 9.2 8 11 3.2Z"/><path d="M18 14.6l.75 1.95 1.95.75-1.95.75-.75 1.95-.75-1.95-1.95-.75 1.95-.75.75-1.95Z"/>'
  };
  const svgIco = (name) => '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round">' + TILE_ICONS[name] + '</svg>';
  const badge = (name) => '<span class="icon-badge" aria-hidden="true">' + svgIco(name) + '</span>';
%>
<div class="grid kpis">
<%# Eight tiles down to four, 16 Sept 2026. Booked child-days, Seats filled, Casual
    days and Total places were all the "All centres" row of the table below, moved one screen up, and
    days and Total places were the "All centres" row of the table below, moved one screen up, and
    answered the same question as Avg occupancy. Seats and Avg/day printed the identical number for
    every centre. They are all still in the table, per centre, where they can be compared.
    Utilisation STAYS: it is a different question — this range against annual capacity, year to date —
    and it is the figure the CEO asked for against 251 days × 499 places. The year toggle hangs off it. %>
<%# The concept's shape, 17 Sept 2026: pale icon badge, label beside it, big number, then the small
    line under it. Every word of label and sub-line is the wording these tiles already carried — the
    tiles gained a badge and lost the cramped label-then-caption stack, not any new content.
    The concept's sub-line is a delta ("+2% from last week"). This app holds no prior-period figure for
    any of these four — the range is whatever the reader picked, and nothing computes the one before it
    — so the slot carries the qualifier each tile already printed, and Attendance and Fees, which have
    no qualifier on a past-only range, print no line at all rather than a comparison nobody could check.
    The occClass -text classes are kept as they were; note that they are currently inert everywhere in
    this app, because .stat .n and .sc-n both set a colour and out-specify .good-text. %>
  <div class="card stat-card">
    <div class="sc-top"><%- badge('occupancy') %><span class="sc-label">Avg occupancy</span></div>
    <div class="sc-n <%= totals.op_days ? occClass(totals.occupancy) + '-text' : '' %>"><%= totals.op_days ? totals.occupancy + '%' : '—' %></div>
    <div class="sc-delta"><%= totals.op_days ? plural(totals.op_days, 'operating day') : 'no operating days in range' %></div>
    <% if (hasFuture) { %><div class="sc-delta ahead"><%= aheadCap %></div><% } %>
  </div>
  <div class="card stat-card">
    <div class="sc-top"><%- badge('attendance') %><span class="sc-label">Attendance rate</span></div>
    <div class="sc-n"><%= totals.past_days ? totals.attendance_rate + '%' : '—' %></div>
    <% if (hasFuture) { %><div class="sc-delta ahead">past days only<%= totals.past_days ? ' (' + plural(totals.past_days, 'day') + ')' : ' — none in this range' %></div><% } %>
  </div>
  <div class="card stat-card">
    <div class="sc-top"><%- badge('year') %><span class="sc-label">Utilisation <%= util.ytdLabel %> · <%= util.label %></span></div>
    <div class="sc-n <%= utilRow ? occClass(utilRow.utilisation) + '-text' : '' %>"><%= utilRow ? utilRow.utilisation + '%' : '—' %></div>
    <div class="sc-delta"><% if (utilRow && utilRow.annual_child_days) { %>of <%= (utilRow.annual_child_days).toLocaleString('en-AU') %> child-days a year<% } else { %>no licensed places recorded for this centre yet<% } %></div>
    <%# The year toggle gets its own line: on one line with the denominator it wrapped between the FY
        and the CY, which reads as a broken sentence rather than a choice of two. %>
    <div class="sc-delta"><a href="<%= yearQS('fy') %>" class="<%= util.kind === 'fy' ? 'on' : '' %>" title="Financial year, from 1 July">FY</a> | <a href="<%= yearQS('cy') %>" class="<%= util.kind === 'cy' ? 'on' : '' %>" title="Calendar year, from 1 January">CY</a></div>
  </div>
  <div class="card stat-card">
    <div class="sc-top"><%- badge('fees') %><span class="sc-label"><%= hasFuture ? 'Fees: billed to date + booked ahead' : 'Fees billed' %></span></div>
    <div class="sc-n"><%= money(totals.fee_total) %></div>
    <% if (hasFuture) { %><div class="sc-delta ahead"><%= money(totals.fee_past) %> billed to date · <%= money(totals.fee_future) %> booked ahead</div><% } %>
  </div>
</div>
<%# The tile grid closes here. It lost its closing tag when eight tiles became four, which put the
    whole rest of the page — briefing, People & experience, trends, the centre table — inside the
    tile grid as further grid cells. %>

<%
  // Minimal, safe Markdown -> HTML for the AI briefing (headings, bullets, bold/italic).
  function _esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
  function _mdInline(s){ return _esc(s).replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>').replace(/(^|[^*])\*(?!\*)(.+?)\*/g,'$1<em>$2</em>'); }
  function mdToHtml(md){
    const lines = String(md||'').split(/\r?\n/); let out=''; let inList=false;
    for (const raw of lines){ const line = raw.trim();
      if(!line){ if(inList){out+='</ul>';inList=false;} continue; }
      const b = line.match(/^[-*]\s+(.*)$/); const h = line.match(/^(#{1,3})\s+(.*)$/);
      if(b){ if(!inList){out+='<ul>';inList=true;} out+='<li>'+_mdInline(b[1])+'</li>'; continue; }
      if(inList){out+='</ul>';inList=false;}
      if(h){ const lvl=Math.min(h[1].length+2,5); out+='<h'+lvl+'>'+_mdInline(h[2])+'</h'+lvl+'>'; }
      else out+='<p>'+_mdInline(line)+'</p>';
    }
    if(inList)out+='</ul>'; return out;
  }
  const canGenerate = ['admin','ops_manager'].includes(user.role);
%>
<% if (!locals.scopedOwnaId) { %>
<div class="card ai-brief" id="briefing">
  <div class="pc-head" style="margin-bottom:6px;">
    <div>
      <div class="pcm-name" style="display:flex;align-items:center;gap:8px;"><span class="title-ico" aria-hidden="true"><%- svgIco('sparkle') %></span>AI briefing
        <span class="badge count" style="font-size:10px;"><%= briefingRangeLabel %></span>
      </div>
      <div class="pcm-cad">Written by Claude from the selected period<% if (briefing) { %> · generated <%= (briefing.created_at||'').slice(0,16) %><% } %></div>
    </div>
    <% if (canGenerate && (typeof aiEnabled==='undefined' || aiEnabled)) { %>
      <form method="POST" action="/ai/briefing" class="inline" onsubmit="this.querySelector('button').disabled=true;this.querySelector('button').textContent='Generating…';">
        <input type="hidden" name="from" value="<%= from %>">
        <input type="hidden" name="to" value="<%= to %>">
        <button type="submit" class="secondary-btn"><%= briefing ? '↻ Refresh' : 'Generate for these dates' %></button>
      </form>
    <% } %>
  </div>
  <% if (typeof briefingError !== 'undefined' && briefingError) { %><div class="flash bad" style="margin:8px 0;"><%= briefingError %></div><% } %>
  <% if (briefing) { %>
    <div class="brief-body"><%- mdToHtml(briefing.content) %></div>
  <% } else if (typeof aiEnabled !== 'undefined' && !aiEnabled) { %>
    <p class="sub" style="margin:6px 0 0;">Set an <code>ANTHROPIC_API_KEY</code> environment variable (and optionally <code>AI_MODEL</code>) to enable this. It calls the Claude API server-side to summarise the week — what moved and what to watch — across all centres.</p>
  <% } else { %>
    <p class="sub" style="margin:6px 0 0;">No briefing for <strong><%= briefingRangeLabel %></strong> yet<%= canGenerate ? ' — hit Generate to have Claude summarise these dates.' : '. Ask an admin to generate one.' %></p>
  <% } %>
</div>
<% } %>

<% if (typeof pcGroup !== 'undefined' && pcGroup) {
     const t = pcGroup.targets || {};
     const mlab = (mm)=>{ if(!mm) return ''; const [y,mo]=mm.split('-'); return new Date(y,mo-1,1).toLocaleDateString('en-AU',{month:'short',year:'2-digit'}); };
     const pf = (v,target,better)=>{ if(v==null||target==null) return ''; const ok = better==='low' ? v<=target : v>=target; return ok?'good-text':'bad-text'; };
     const pv = (v,suf='')=> v==null?'—':v+suf;
%>
<div class="card">
  <div class="card-head">
    <h2>People &amp; experience <span class="muted" style="font-weight:400;font-size:13px;">· group average · <%= mlab(pcGroup.month) %></span></h2>
    <a class="view-all" href="/pc">People &amp; Culture</a>
  </div>
  <div class="grid kpis">
    <div class="card stat"><div class="n <%= pf(pcGroup.enps,t.enps,'high') %>"><%= pv(pcGroup.enps) %></div><div class="l">eNPS<% if(t.enps!=null){ %> · ≥<%= t.enps %><% } %></div></div>
    <div class="card stat"><div class="n <%= pf(pcGroup.family_nps,t.family_nps,'high') %>"><%= pv(pcGroup.family_nps) %></div><div class="l">Family NPS<% if(t.family_nps!=null){ %> · ≥<%= t.family_nps %><% } %></div></div>
    <div class="card stat"><div class="n <%= pf(pcGroup.turnover,t.turnover,'low') %>"><%= pv(pcGroup.turnover,'%') %></div><div class="l">Turnover<% if(t.turnover!=null){ %> · ≤<%= t.turnover %>%<% } %></div></div>
    <div class="card stat"><div class="n <%= pf(pcGroup.checkin_pct,t.checkin_pct,'high') %>"><%= pv(pcGroup.checkin_pct,'%') %></div><div class="l">Career check-ins</div></div>
    <div class="card stat"><div class="n <%= pf(pcGroup.psych_safety,t.psych_safety,'high') %>"><%= pv(pcGroup.psych_safety) %></div><div class="l">Psych safety</div></div>
  </div>
</div>
<% } %>

<% if (typeof occTrend !== 'undefined' && occTrend && occTrend.length > 1) {
     const mLbl = function(m){ var p=m.split('-'); return new Date(p[0],p[1]-1,1).toLocaleDateString('en-AU',{month:'short',year:'2-digit'}); };
     const oLbls = occTrend.map(function(t){ return mLbl(t.month); });
     const firstProj = occTrend.findIndex(function(t){ return t.projected; });
     const oDash = firstProj > 0 ? firstProj - 1 : (firstProj === 0 ? 0 : null); // dash from last actual → projected
     const occLc = { labels:oLbls, height:180, suf:'%', dashFrom: (oDash!=null?oDash:null), series:[
       { name:'Occupancy', points: occTrend.map(function(t){return t.occupancy;}) },
       { name:'Attendance', points: occTrend.map(function(t){return t.attendance_rate;}) },
     ]};
     // Revenue: complete months only (a partial/scheduled month understates a monthly $ sum).
     const revMonths = occTrend.filter(function(t){ return !t.projected; });
     const revLc = { labels: revMonths.map(function(t){return mLbl(t.month);}), height:170, money:true, series:[ { name:'Fees billed', points: revMonths.map(function(t){return t.fee_total;}) } ]};
%>
<div class="card">
  <div class="card-head"><h2>Group trends <span class="muted" style="font-weight:400;font-size:13px;">· monthly</span></h2><a class="view-all" href="/compare">Compare centres</a></div>
  <h3 class="card-sub">Occupancy &amp; attendance % <span class="muted" style="font-weight:400;font-size:12px;">· dashed = projected from scheduled bookings</span></h3>
  <%- include('partials/linechart', { lc: occLc }) %>
  <h3 class="card-sub">Fees billed (revenue) <span class="muted" style="font-weight:400;font-size:12px;">· complete months</span></h3>
  <%- include('partials/linechart', { lc: revLc }) %>
</div>
<% } %>

<div class="card">
  <%# No "View all →" here on purpose: every row already carries its own Details → into that centre,
      and the only all-centres page deeper than this table is /compare, which the trends card above
      already points at. A second link to it would be a link added to fill a slot. %>
  <div class="card-head"><h2>By centre</h2></div>
  <div class="table-scroll">
  <table>
    <thead>
      <tr>
        <th>Centre</th><th title="Approved places on the service approval (ACECQA National Register)">Places</th><%# "Avg/day" removed 16 Sept 2026: booked ÷ days-with-data, which printed the same number as Seats
    for every centre. Seats is the one to keep — it divides by OPERATING days, so a public-holiday
    booking row cannot flatter it. %>
        <th class="num" title="<%= seatsForward ? 'Seats booked: average booked children per operating day across the selected range. These are bookings, not attendance — the range runs past the last observed day.' : 'Seats filled: average booked children per operating day (weekdays excluding NSW public holidays)' %>">Seats<% if (seatsForward) { %> <span class="muted" style="font-weight:400;text-transform:none;letter-spacing:0">booked</span><% } %></th>
        <th style="width:160px;" title="<%= hasFuture ? 'Includes days booked ahead — departures not yet deducted, so this overstates' : 'Booked child-days on operating days ÷ (places × operating days)' %>">Occupancy<% if (hasFuture) { %> <span class="th-cap">booked ahead</span><% } %></th>
        <th class="num" title="Projected occupancy over the next 30 days from scheduled bookings">Fcast 30d</th>
        <th class="num" title="<%= hasFuture ? 'Attendance is only known for past days' : 'Attended ÷ booked' %>">Attend.<% if (hasFuture) { %> <span class="th-cap">past days only</span><% } %></th>
        <th class="num"<%- hasFuture ? ' title="Includes casual bookings ahead"' : '' %>>Casual</th><th class="num"><%= hasFuture ? 'Fees billed to date + booked ahead' : 'Fees billed' %></th>
        <th class="num" title="Families on the LineLeader waitlist">Waitlist</th>
        <th class="num" title="Upcoming expected starts (LineLeader)">Upcoming</th><th></th>
      </tr>
    </thead>
    <tbody>
      <% rows.forEach(function(r){ %>
        <tr>
          <td><a class="row-link" href="/centre/<%= r.owna_id %>?<%= rangeQS %>"><%= shortName(r.name) %></a></td>
          <td><%= r.places != null ? r.places : '—' %></td>
          <% var sr = seats.byOwna[r.owna_id]; %>
          <td class="num"><%= sr && sr.days ? sr.seats : '—' %></td>
          <td>
            <% if (r.op_days && r.occupancy != null) { %>
            <div class="bar-wrap" title="<%= r.op_booked %> booked child-days over <%= plural(r.op_days, 'operating day') %>">
              <div class="bar <%= occClass(r.occupancy) %>" style="width:<%= Math.min(r.occupancy,100) %>%;"></div>
              <span class="bar-val"><%= r.occupancy %>%</span>
            </div>
            <% } else { %><span class="muted">—</span><% } %>
          </td>
          <% var f = fcast[r.owna_id]; %>
          <td class="num"><% if (f && f.days && f.occupancy != null) { %><span class="<%= occClass(f.occupancy) %>-text" style="font-weight:600;"><%= f.occupancy %>%</span><% } else { %><span class="muted">—</span><% } %></td>
          <td class="num"><%= r.past_days ? r.attendance_rate + '%' : '—' %></td>
          <td class="num"><%= r.casual %></td>
          <td class="num"><% if (hasFuture) { %><%= money(r.fee_past) %><br><span class="muted fee-ahead">+ <%= money(r.fee_future) %> ahead</span><% } else { %><%= money(r.fee_total) %><% } %></td>
          <% var ll = llMap[r.owna_id]; %>
          <td class="num <%= ll && ll.waitlist>0 ? 'hot' : '' %>"><%= ll ? ll.waitlist : '—' %></td>
          <td class="num"><%= ll ? ll.starts_future : '—' %></td>
          <td class="num"><a class="row-link" href="/centre/<%= r.owna_id %>?<%= rangeQS %>">Details →</a></td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <% var llTotWait=0, llTotUp=0; Object.values(llMap).forEach(function(x){llTotWait+=x.waitlist;llTotUp+=x.starts_future;});
         var fB=0, fCD=0; rows.forEach(function(r){ var f=fcast[r.owna_id]; if(f&&f.days&&r.places!=null){ fB+=f.booked; fCD+=r.places*f.days; } });
         var fcastAll = fCD ? Math.round(fB/fCD*1000)/10 : 0; %>
      <tr class="total-row">
        <td>All centres</td><td><%= totals.places ? totals.places : '—' %></td>
        <td class="num" <% if (seats.raggedCoverage && seats.coverageRange) { %>title="Centres have bookings over different numbers of days in this range (<%= seats.coverageRange.min %> to <%= seats.coverageRange.max %>), so each centre is averaged over its own days and this is their sum."<% } %>><%= seatsRow && seatsRow.days ? seatsRow.seats : '—' %><% if (seats.raggedCoverage) { %><span class="muted">*</span><% } %></td>
        <td><% if (totals.op_days) { %><div class="bar-wrap"><div class="bar <%= occClass(totals.occupancy) %>" style="width:<%= Math.min(totals.occupancy,100) %>%;"></div><span class="bar-val"><%= totals.occupancy %>%</span></div><% } else { %><span class="muted">—</span><% } %></td>
        <td class="num"><span class="<%= occClass(fcastAll) %>-text"><%= fcastAll %>%</span></td>
        <td class="num"><%= totals.past_days ? totals.attendance_rate + '%' : '—' %></td>
        <td class="num"><%= totals.casual %></td>
        <td class="num"><% if (hasFuture) { %><%= money(totals.fee_past) %><br><span class="muted fee-ahead">+ <%= money(totals.fee_future) %> ahead</span><% } else { %><%= money(totals.fee_total) %><% } %></td>
        <td class="num"><%= llTotWait %></td>
        <td class="num"><%= llTotUp %></td><td></td>
      </tr>
    </tfoot>
  </table>
  </div>
</div>

<p class="footnote">
  <%# Was 264 words restating formulas that the Approved places admin page and /coe/method already
      carry. What is left is the one thing a reader of THIS page has to know: that a range ending in
      the future is partly booked ahead. %>
  Occupancy = booked child-days ÷ (places × operating days), against each service's approved places.
  <% if (hasFuture) { %><strong>This range ends after today</strong>, so booked, occupancy and casual figures include days booked ahead and do not deduct departures; attendance uses past days only.<% } %>
  <% if (lastRun) { %>· Data as at <%= sydneyStamp(lastRun.finished_at || lastRun.started_at) %> (<%= lastRun.status %><% if (lastRun.note && ['admin','ops_manager'].includes(user.role)) { %> — <%= lastRun.note %><% } %>)<% } else { %>· No snapshot yet — click "Refresh from OWNA".<% } %>
</p>

<%- include('partials/footer') %>
