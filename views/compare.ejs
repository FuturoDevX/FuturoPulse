<%- include('partials/header', { title: 'Compare' }) %>
<%
  const cfg = data.cfg;
  const fmtWk = (d) => new Date(d+'T00:00:00').toLocaleDateString('en-AU',{day:'numeric',month:'short'});
  const fmtMo = (m) => { const p=m.split('-'); return new Date(p[0],p[1]-1,1).toLocaleDateString('en-AU',{month:'short',year:'2-digit'}); };
  const labels = data.axis.map(a => data.cadence==='week' ? fmtWk(a) : fmtMo(a));
  const fmtV = (v) => v==null ? '—' : (cfg.money ? '$'+Math.round(v).toLocaleString('en-AU') : (Math.round(v*10)/10)+(cfg.suf||''));
  // latest non-null per centre, for the ranked table
  const rank = data.series.map(s => { const nn = s.points.filter(v=>v!=null); return { name:s.name, latest: nn.length?nn[nn.length-1]:null }; })
    .filter(r => r.latest!=null)
    .sort((a,b) => cfg.better==='low' ? a.latest-b.latest : b.latest-a.latest);
%>
<div class="page-head">
  <div>
    <h1>Compare centres</h1>
    <p class="sub"><%= cfg.label %> over time · every centre, <%= data.cadence==='week' ? 'weekly' : 'monthly' %></p>
  </div>
  <div class="head-actions">
    <form method="GET"><select name="metric" onchange="this.form.submit()">
      <% Object.keys(metrics).forEach(function(k){ %><option value="<%= k %>" <%= k===metric?'selected':'' %>><%= metrics[k].label %></option><% }); %>
    </select></form>
  </div>
</div>

<div class="card">
  <h2 style="margin-top:0;"><%= cfg.label %> <span class="muted" style="font-weight:400;font-size:13px;">· each line is a centre</span></h2>
  <%- include('partials/linechart', { lc: { labels: labels, series: data.series, suf: cfg.suf, money: cfg.money, height: 240 } }) %>
</div>

<% if (rank.length) { %>
<div class="card">
  <h2 style="margin-top:0;">Latest — ranked</h2>
  <table>
    <thead><tr><th>#</th><th>Centre</th><th class="num"><%= cfg.label %></th></tr></thead>
    <tbody>
      <% rank.forEach(function(r,i){ %>
        <tr><td class="num" style="width:30px;color:var(--muted);"><%= i+1 %></td><td><%= r.name %></td><td class="num" style="font-weight:600;"><%= fmtV(r.latest) %></td></tr>
      <% }); %>
    </tbody>
  </table>
  <p class="footnote">Ranked by the most recent value (<%= cfg.better==='low' ? 'lower is better' : 'higher is better' %>). Weekly metrics use finalised Employment Hero pay weeks; occupancy &amp; P&amp;C are monthly. Lines skip periods with no data. Hover a point for its value.</p>
</div>
<% } %>

<%- include('partials/footer') %>
