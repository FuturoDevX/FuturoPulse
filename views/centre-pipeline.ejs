<%- include('partials/header', { title: centre.name + ' — Pipeline' }) %>
<%
  const shortName = (n) => (n||'').replace('Futuro Childcare & Education - ','').replace(/Futuro Childcare (and|&) Education\s*-?\s*/i,'').replace('Futuro ','').trim();
  const d = detail;
  const dt = (s) => s ? new Date(s + (s.length<=10 ? 'T00:00:00' : '')).toLocaleDateString('en-AU', { day:'numeric', month:'short', year:'numeric' }) : '—';
  const dtt = (s) => s ? new Date(s).toLocaleDateString('en-AU', { weekday:'short', day:'numeric', month:'short' }) + ' ' + new Date(s).toLocaleTimeString('en-AU',{hour:'numeric',minute:'2-digit'}) : '—';
  const mth = (m) => { const [y,mo]=m.split('-'); return new Date(y,mo-1,1).toLocaleDateString('en-AU',{month:'short',year:'2-digit'}); };
%>

<% if (!d) { %>
  <div class="page-head"><div><h1><%= shortName(centre.name) %> — Pipeline</h1></div></div>
  <div class="card"><p class="muted">This centre isn't linked to a LineLeader centre, so there's no pipeline data.</p></div>
<% } else {
  const wlTrend = d.waitlistTrend || [];
  const maxTrend = Math.max(1, ...wlTrend.map(x => x.n));
%>

<div class="page-head">
  <div>
    <p class="crumb"><a href="/centre/<%= centre.owna_id %>">← <%= shortName(centre.name) %></a> / Pipeline</p>
    <h1><%= shortName(centre.name) %> — Enrolment Pipeline</h1>
    <p class="sub">Where every family sits in the flow, upcoming tours, and how the waitlist has grown · from LineLeader</p>
  </div>
</div>

<!-- Funnel -->
<div class="card">
  <h2 style="margin-top:0;">Funnel <span class="muted" style="font-weight:400;font-size:13px;">· families at each stage</span></h2>
  <div class="funnel">
    <% d.funnel.forEach(function(s){ %>
      <div class="funnel-step <%= s.id===4 ? 'hot' : '' %>">
        <div class="fs-n"><%= s.count %></div>
        <div class="fs-l"><%= s.name %></div>
      </div>
      <% if (s.id !== 5) { %><div class="funnel-arrow">→</div><% } %>
    <% }); %>
  </div>
</div>

<div class="two-col">
  <!-- Upcoming tours -->
  <div class="card">
    <h2 style="margin-top:0;">Upcoming tours &amp; orientations <span class="badge good"><%= d.upcomingTours.length %></span></h2>
    <% if (!d.upcomingTours.length) { %>
      <p class="muted">None scheduled.</p>
    <% } else { %>
      <table>
        <thead><tr><th>When</th><th>Type</th></tr></thead>
        <tbody>
          <% d.upcomingTours.forEach(function(t){ %>
            <tr>
              <td><%= dtt(t.tour_date) %></td>
              <td><span class="reason-tag"><%= t.type_name || 'Tour' %></span></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
      <p class="footnote" style="margin-top:10px;">This is every booked visit on the calendar. Which family each booking belongs to is in LineLeader — this dashboard holds no family name. The funnel counts a family's <em>current stage</em>, so a booked tour can belong to a family who has already moved on (e.g. Offer Accepted), and orientations happen after acceptance — which is why this can exceed "Tour Scheduled".</p>
    <% } %>
  </div>

  <!-- Waitlist over time -->
  <div class="card">
    <h2 style="margin-top:0;">Waitlist joins over time</h2>
    <p class="sub" style="margin:0 0 10px;">When the current waitlist families joined (by month)</p>
    <% if (!wlTrend.length) { %>
      <p class="muted">No waitlist join dates recorded.</p>
    <% } else { %>
      <div class="chart" style="height:150px;">
        <% wlTrend.forEach(function(w){ %>
          <div class="chart-col" title="<%= mth(w.month) %>: <%= w.n %> joined">
            <div class="chart-bar good" style="height:<%= Math.round(w.n/maxTrend*100) %>%;"></div>
            <div class="chart-x"><%= mth(w.month) %><br><span><%= w.n %></span></div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>

<!-- Members by stage: counts and wanted start months, never names -->
<div class="card">
  <h2 style="margin-top:0;">What's in the pipeline <span class="muted" style="font-weight:400;font-size:13px;">· children per stage, by the month they want to start</span></h2>
  <% d.stages.slice().reverse().forEach(function(st){ var s = d.membersByStage[st[0]]; if (!s || !s.count) return; %>
    <div class="stage-block">
      <h3 class="stage-h <%= st[0]===4 ? 'hot-h' : '' %>"><%= st[1] %> <span class="badge"><%= s.count %></span></h3>
      <% if (st[0]===4 && s.joined_from) { %>
        <p class="sub" style="margin:0 0 8px;">Joined the waitlist between <%= dt(s.joined_from) %> and <%= dt(s.joined_to) %>.</p>
      <% } %>
      <% if (!s.starts.length) { %>
        <p class="muted" style="margin:0;">No start month recorded for any of them.</p>
      <% } else { %>
      <div style="overflow-x:auto;">
        <table>
          <thead><tr><th><%= st[0]===4 ? 'Wanted start' : 'Expected start' %></th><th class="num">Children</th></tr></thead>
          <tbody>
            <% s.starts.forEach(function(x){ %>
              <tr><td><%= mth(x.month) %></td><td class="num"><%= x.n %></td></tr>
            <% }); %>
            <% if (s.no_start) { %><tr><td class="muted">Not recorded</td><td class="num"><%= s.no_start %></td></tr><% } %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  <% }); %>
</div>

<p class="footnote">
  Funnel counts are families (matches the rest of the dashboard); the stage counts above are children, so a family with siblings is counted once per child. "Joined waitlist" is the LineLeader wait-list date. Tours come from LineLeader tasks (Tour + Orientation Day). <strong>No child's or family's name is stored by this dashboard</strong> — it is a derived system, and LineLeader stays the record of who each family is. A row here is a LineLeader id, a centre, a stage and dates.
</p>

<% } %>
<%- include('partials/footer') %>
