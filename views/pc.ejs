<%- include('partials/header', { title: 'People & Culture' }) %>
<%
  const shortName = (n) => (n||'').replace(/Futuro Childcare (and|&) Education\s*-?\s*/i,'').replace('Futuro ','').trim();
  const mLbl = (m) => { if(!m) return ''; const p=m.split('-'); return new Date(p[0],p[1]-1,1).toLocaleDateString('en-AU',{month:'short',year:'2-digit'}); };
  const selName = owna ? shortName((centres.find(function(c){return c.owna_id===owna;})||{}).name) : 'All centres (average)';
  const METRICS = [
    { key:'enps',         name:'eNPS',                 cadence:'quarterly',     suf:'',  target: targets.enps,         better:'high', scale:[-100,100] },
    { key:'family_nps',   name:'Family NPS',           cadence:'every 6 months',suf:'',  target: targets.family_nps,   better:'high', scale:[-100,100] },
    { key:'turnover',     name:'Turnover',             cadence:'monthly',       suf:'%', target: targets.turnover,     better:'low' },
    { key:'checkin_pct',  name:'Career check-ins',     cadence:'monthly',       suf:'%', target: targets.checkin_pct,  better:'high' },
    { key:'psych_safety', name:'Psychological safety', cadence:'quarterly',     suf:'',  target: targets.psych_safety, better:'high' },
  ];
  // Build an SVG line chart model over the month axis, skipping null gaps.
  function chart(points, target, w, h) {
    const vals = points.filter(function(v){return v!=null;});
    if (!vals.length) return null;
    let mn=Math.min.apply(null,vals), mx=Math.max.apply(null,vals);
    if (target!=null){ mn=Math.min(mn,target); mx=Math.max(mx,target); }
    const pad=((mx-mn)*0.12)||1; mn-=pad; mx+=pad; const rng=(mx-mn)||1; const n=points.length;
    const x=function(i){ return n===1? w/2 : (i/(n-1))*w; };
    const y=function(v){ return h-((v-mn)/rng)*(h-3)-1.5; };
    const seg=[]; let cur=[];
    points.forEach(function(v,i){ if(v==null){ if(cur.length){seg.push(cur);cur=[];} } else cur.push(x(i).toFixed(1)+','+y(v).toFixed(1)); });
    if(cur.length) seg.push(cur);
    const dots=[]; points.forEach(function(v,i){ if(v!=null) dots.push({cx:x(i).toFixed(1), cy:y(v).toFixed(1)}); });
    return { seg: seg.map(function(s){return s.join(' ');}), dots: dots, ty: target!=null? y(target).toFixed(1):null };
  }
  const flag = (v,target,better)=>{ if(v==null||target==null) return ''; const ok = better==='low' ? v<=target : v>=target; return ok?'good-text':'bad-text'; };
%>
<div class="page-head">
  <div>
    <h1>People &amp; Culture</h1>
    <p class="sub">Trends over time · <%= selName %></p>
  </div>
  <div class="head-actions" style="display:flex;gap:10px;align-items:center;">
    <% if (!locals.scopedOwnaId && centres.length) { %>
    <form method="GET"><select name="owna" onchange="this.form.submit()">
      <option value="" <%= !owna?'selected':'' %>>All centres (avg)</option>
      <% centres.forEach(function(c){ %><option value="<%= c.owna_id %>" <%= c.owna_id===owna?'selected':'' %>><%= shortName(c.name) %></option><% }); %>
    </select></form>
    <% } %>
    <% var _q = owna ? ('&owna='+owna) : ''; %>
    <a class="secondary-btn" style="text-decoration:none;padding:7px 12px;border-radius:6px;" href="/pc?full=<%= full?'0':'1' %><%= _q %>"><%= full ? 'Show recent only' : 'Explore full history' %></a>
    <% if (user.role === 'admin') { %><a class="secondary-btn" style="text-decoration:none;padding:7px 12px;border-radius:6px;" href="/admin/pc">Enter data</a><% } %>
  </div>
</div>

<%
  const _mIdx = METRICS.findIndex(function(x){ return x.key === metric; });
  const mt = METRICS[_mIdx < 0 ? 0 : _mIdx];
  const _link = function(k){ return '/pc?metric=' + k + (full?'&full=1':'') + _q; };
  const s = series[mt.key] || { labels:[], points:[], full:0, shown:0 };
  const pts = s.points;
  const latest = pts.length ? pts[pts.length-1] : null;
  const pcLc = { labels: s.labels, height: 300, suf: mt.suf, target: mt.target, connect: true, series: [ { name: mt.name, points: pts } ] };
%>
<div class="pc-tabs">
  <% METRICS.forEach(function(x){ %>
    <a href="<%= _link(x.key) %>" class="pc-tab <%= x.key===mt.key?'active':'' %>"><%= x.name %></a>
  <% }); %>
</div>
<div class="card pc-metric" style="margin-top:14px;">
  <div class="pc-head">
    <div>
      <div class="pcm-name" style="font-size:20px;"><%= mt.name %></div>
      <div class="pcm-cad"><%= mt.cadence %><% if(mt.target!=null){ %> · target <%= mt.better==='low'?'≤':'≥' %><%= mt.target %><%= mt.suf %><% } %></div>
    </div>
    <div class="pcm-val <%= flag(latest, mt.target, mt.better) %>" style="font-size:40px;"><%= latest==null ? '—' : latest+mt.suf %></div>
  </div>
  <div style="margin-top:18px;">
    <%- include('partials/linechart', { lc: pcLc }) %>
  </div>
  <div class="pcm-cad" style="margin-top:12px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
    <span>
      <% if (s.full > s.shown) { %>Showing last <%= s.shown %> of <%= s.full %> · <a href="/pc?metric=<%= mt.key %>&full=1<%= _q %>">explore all</a><% } else if (full && s.full > 0) { %>Full history (<%= s.full %> periods) · <a href="/pc?metric=<%= mt.key %><%= _q %>">recent only</a><% } else { %><%= s.full %> period<%= s.full===1?'':'s' %> of data<% } %>
    </span>
    <span style="display:flex;gap:8px;">
      <% var _prev = METRICS[(_mIdx-1+METRICS.length)%METRICS.length], _next = METRICS[(_mIdx+1)%METRICS.length]; %>
      <a class="pc-navbtn" href="<%= _link(_prev.key) %>">← <%= _prev.name %></a>
      <a class="pc-navbtn" href="<%= _link(_next.key) %>"><%= _next.name %> →</a>
    </span>
  </div>
</div>

<p class="footnote">
  Each chart is bucketed by that metric’s own cadence — <strong>eNPS</strong> &amp; <strong>psych safety</strong> by quarter (Q1 25…), <strong>Family NPS</strong> by half-year (H1 25…), <strong>turnover</strong> &amp; <strong>career check-ins</strong> by month. It shows the most recent periods by default; use <strong>Explore full history</strong> (or a card’s “explore all”) to see the whole lifetime. The amber dashed line is the target. Switch between the group average and a single centre with the selector. eNPS &amp; turnover come from the SharePoint upload; the rest are entered in <strong>Admin → P&amp;C Data</strong>. eNPS/Family NPS run −100…100.
</p>

<%- include('partials/footer') %>
