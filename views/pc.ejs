<%- include('partials/header', { title: 'People & Culture' }) %>
<%
  const shortName = (n) => (n||'').replace(/Futuro Childcare (and|&) Education\s*-?\s*/i,'').replace('Futuro ','').trim();
  const mLbl = (m) => { if(!m) return ''; const p=m.split('-'); return new Date(p[0],p[1]-1,1).toLocaleDateString('en-AU',{month:'short',year:'2-digit'}); };
  const selName = owna ? shortName((centres.find(function(c){return c.owna_id===owna;})||{}).name) : 'All centres (average)';
  const METRICS = [
    { key:'enps',         name:'eNPS',                 cadence:'quarterly',     suf:'',  target: targets.enps,         better:'high', scale:[-100,100] },
    { key:'family_nps',   name:'Family NPS',           cadence:'every 6 months',suf:'',  target: targets.family_nps,   better:'high', scale:[-100,100] },
    { key:'turnover',     name:'Turnover',             cadence:'rolling 12 months · entered', suf:'%', target: targets.turnover,     better:'low' },
    { key:'checkin_pct',  name:'Career check-ins',     cadence:'monthly',       suf:'%', target: targets.checkin_pct,  better:'high' },
    { key:'psych_safety', name:'Psychological safety', cadence:'quarterly',     suf:'',  target: targets.psych_safety, better:'high' },
  ];
  // Build an SVG line chart model over the month axis, skipping null gaps.
  function chart(points, target, w, h) {
    const vals = points.filter(function(v){return v!=null;});
    if (!vals.length) return null;
    let mn=Math.min.apply(null,vals), mx=Math.max.apply(null,vals);
    if (target!=null){ mn=Math.min(mn,target); mx=Math.max(mx,target); }
    const pad=((mx-mn)*0.12)||1; mn-=pad; mx+=pad; const rng=(mx-mn)||1; const n=points.length;
    const x=function(i){ return n===1? w/2 : (i/(n-1))*w; };
    const y=function(v){ return h-((v-mn)/rng)*(h-3)-1.5; };
    const seg=[]; let cur=[];
    points.forEach(function(v,i){ if(v==null){ if(cur.length){seg.push(cur);cur=[];} } else cur.push(x(i).toFixed(1)+','+y(v).toFixed(1)); });
    if(cur.length) seg.push(cur);
    const dots=[]; points.forEach(function(v,i){ if(v!=null) dots.push({cx:x(i).toFixed(1), cy:y(v).toFixed(1)}); });
    return { seg: seg.map(function(s){return s.join(' ');}), dots: dots, ty: target!=null? y(target).toFixed(1):null };
  }
  const flag = (v,target,better)=>{ if(v==null||target==null) return ''; const ok = better==='low' ? v<=target : v>=target; return ok?'good-text':'bad-text'; };
%>
<div class="page-head">
  <div>
    <h1>People &amp; Culture</h1>
    <p class="sub">Trends over time · <%= selName %></p>
  </div>
  <div class="head-actions" style="display:flex;gap:10px;align-items:center;">
    <% if (!locals.scopedOwnaId && centres.length) { %>
    <form method="GET"><select name="owna" onchange="this.form.submit()">
      <option value="" <%= !owna?'selected':'' %>>All centres (avg)</option>
      <% centres.forEach(function(c){ %><option value="<%= c.owna_id %>" <%= c.owna_id===owna?'selected':'' %>><%= shortName(c.name) %></option><% }); %>
    </select></form>
    <% } %>
    <% var _q = owna ? ('&owna='+owna) : ''; %>
    <a class="secondary-btn" style="text-decoration:none;padding:7px 12px;border-radius:6px;" href="/pc?full=<%= full?'0':'1' %><%= _q %>"><%= full ? 'Show recent only' : 'Explore full history' %></a>
    <% if (['admin','ops_manager'].includes(user.role)) { %><a class="secondary-btn" style="text-decoration:none;padding:7px 12px;border-radius:6px;" href="/admin/pc">Enter data</a><% } %>
  </div>
</div>

<%
  const _mIdx = METRICS.findIndex(function(x){ return x.key === metric; });
  const mt = METRICS[_mIdx < 0 ? 0 : _mIdx];
  const _link = function(k){ return '/pc?metric=' + k + (full?'&full=1':'') + _q; };
  const s = series[mt.key] || { labels:[], points:[], full:0, shown:0 };
  const pts = s.points;
  const latest = pts.length ? pts[pts.length-1] : null;
  const pcLc = { labels: s.labels, height: 300, suf: mt.suf, target: mt.target, connect: true, series: [ { name: mt.name, points: pts } ] };
  // A turnover point drawn from a part-filled window is scaled to a year so it sits on the same axis
  // as the full ones; say so while any of the plotted points are.
  const cadence = (mt.key === 'turnover' && s.partial > 0) ? 'rolling 12 months · annualised while fewer are entered' : mt.cadence;
%>
<div class="pc-tabs">
  <% METRICS.forEach(function(x){ %>
    <a href="<%= _link(x.key) %>" class="pc-tab <%= x.key===mt.key?'active':'' %>"><%= x.name %></a>
  <% }); %>
</div>
<div class="card pc-metric" style="margin-top:14px;">
  <div class="pc-head">
    <div>
      <div class="pcm-name" style="font-size:20px;"><%= mt.name %></div>
      <div class="pcm-cad"><%= cadence %><% if(mt.target!=null){ %> · target <%= mt.better==='low'?'≤':'≥' %><%= mt.target %><%= mt.suf %><% } %></div>
    </div>
    <div class="pcm-val <%= flag(latest, mt.target, mt.better) %>" style="font-size:40px;"><%= latest==null ? '—' : latest+mt.suf %></div>
  </div>
  <div style="margin-top:18px;">
    <%- include('partials/linechart', { lc: pcLc }) %>
  </div>
  <div class="pcm-cad" style="margin-top:12px;display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;">
    <span>
      <% if (s.full > s.shown) { %>Showing last <%= s.shown %> of <%= s.full %> · <a href="/pc?metric=<%= mt.key %>&full=1<%= _q %>">explore all</a><% } else if (full && s.full > 0) { %>Full history (<%= s.full %> periods) · <a href="/pc?metric=<%= mt.key %><%= _q %>">recent only</a><% } else { %><%= s.full %> period<%= s.full===1?'':'s' %> of data<% } %>
    </span>
    <span style="display:flex;gap:8px;">
      <% var _prev = METRICS[(_mIdx-1+METRICS.length)%METRICS.length], _next = METRICS[(_mIdx+1)%METRICS.length]; %>
      <a class="pc-navbtn" href="<%= _link(_prev.key) %>">← <%= _prev.name %></a>
      <a class="pc-navbtn" href="<%= _link(_next.key) %>"><%= _next.name %> →</a>
    </span>
  </div>
</div>

<p class="footnote">
  Each chart is bucketed by that metric’s own cadence — <strong>eNPS</strong> &amp; <strong>psych safety</strong> by quarter (Q1 25…), <strong>Family NPS</strong> by half-year (H1 25…), <strong>turnover</strong> &amp; <strong>career check-ins</strong> by month. It shows the most recent periods by default; use <strong>Explore full history</strong> (or a card’s “explore all”) to see the whole lifetime. The amber dashed line is the target. Switch between the group average and a single centre with the selector. eNPS comes from the SharePoint upload; <strong>turnover</strong> and the rest are entered in <strong>Admin → P&amp;C Data</strong>. eNPS/Family NPS run −100…100.
</p>


<%
  // ===== Turnover, as the owner enters it (his decision of 16 September 2026) =====
  // The turnover figure on this page. Payroll can say someone left; it cannot say whether the business
  // counts it, so the numbers are typed in on /admin/pc and these are three ways of dividing them.
  const to = locals.turnover;
  const toPct = function(v){ return v == null ? '—' : v + '%'; };
  const toRows = to ? (locals.scopedOwnaId ? to.centres.filter(function(c){ return c.owna_id === locals.scopedOwnaId; }) : to.centres).filter(function(c){ return c.window.entered > 0; }) : [];
%>

<h2 class="section-label" id="turnover">Turnover</h2>

<% if (!to || to.window.entered === 0) { %>
<div class="card">
  <p class="muted" style="margin:0;">No turnover has been entered yet<% if (['admin','ops_manager'].includes(user.role)) { %> — <a href="/admin/pc#turnover">enter it</a><% } %>.</p>
</div>
<% } else { %>
<div class="grid kpis">
  <div class="card stat"><div class="n <%= flag(to.rates.combined, targets.turnover, 'low') %>"><%= toPct(to.rates.combined) %></div><div class="l">Combined<span class="cap">resignations + terminations</span></div></div>
  <div class="card stat"><div class="n"><%= toPct(to.rates.resignations) %></div><div class="l">Resignations only<span class="cap"><%= to.resignations == null ? 'none entered' : to.resignations + ' over the window' %></span></div></div>
  <div class="card stat"><div class="n"><%= toPct(to.rates.terminations) %></div><div class="l">Terminations only<span class="cap"><%= to.terminations == null ? 'none entered' : to.terminations + ' over the window' %></span></div></div>
</div>
<p class="footnote" style="margin-top:2px;">
  <% if (to.window.complete) { %>
    <strong>Rolling 12 months</strong> to <%= mLbl(to.window.to) %> — leavers over the twelve months ÷ average headcount (<%= to.avg_headcount == null ? '—' : to.avg_headcount %>).
  <% } else { %>
    <strong>Rolling <%= to.window.entered %> month<%= to.window.entered === 1 ? '' : 's' %></strong>, not a full year — only <%= to.window.entered %> of the twelve months to <%= mLbl(to.window.to) %> ha<%= to.window.entered === 1 ? 's' : 've' %> been entered. Leavers over those months ÷ average headcount (<%= to.avg_headcount == null ? '—' : to.avg_headcount %>).
  <% } %>
  <% if (to.month.rates.combined != null) { %> <%= mLbl(to.month.month) %> alone, <strong>monthly</strong> rather than rolling: <%= toPct(to.month.rates.combined) %> combined, <%= toPct(to.month.rates.resignations) %> resignations, <%= toPct(to.month.rates.terminations) %> terminations.<% } %>
</p>

<% if (!owna && toRows.length) { %>
<div class="card">
  <h2 style="margin-top:0;">By centre — rolling to <%= mLbl(to.window.to) %></h2>
  <div style="overflow-x:auto;"><table>
    <thead><tr>
      <th>Centre</th>
      <th style="text-align:right;">Combined</th>
      <th style="text-align:right;">Resignations</th>
      <th style="text-align:right;">Terminations</th>
      <th style="text-align:right;">Avg headcount</th>
      <th style="text-align:right;">Months</th>
    </tr></thead>
    <tbody>
      <% toRows.forEach(function(c){ %>
      <tr>
        <td><strong><%= shortName(c.name) %></strong></td>
        <td style="text-align:right;font-weight:700;"><%= toPct(c.rates.combined) %></td>
        <td style="text-align:right;"><%= toPct(c.rates.resignations) %></td>
        <td style="text-align:right;"><%= toPct(c.rates.terminations) %></td>
        <td style="text-align:right;"><%= c.avg_headcount == null ? '—' : c.avg_headcount %></td>
        <td style="text-align:right;"><%= c.window.entered %> of 12</td>
      </tr>
      <% }); %>
      <tr style="font-weight:700;border-top:2px solid var(--border);">
        <td>Group</td>
        <td style="text-align:right;"><%= toPct(to.rates.combined) %></td>
        <td style="text-align:right;"><%= toPct(to.rates.resignations) %></td>
        <td style="text-align:right;"><%= toPct(to.rates.terminations) %></td>
        <td style="text-align:right;"><%= to.avg_headcount == null ? '—' : to.avg_headcount %></td>
        <td style="text-align:right;"><%= to.window.entered %> of 12</td>
      </tr>
    </tbody>
  </table></div>
  <p class="footnote">A blank month is not a zero: it is left out of the average headcount and adds no leavers, which is why a centre can show fewer months than another.</p>
</div>
<% } %>

<details class="card working">
  <summary><strong>The months this is based on</strong> — <%= to.window.entered %> of the twelve to <%= mLbl(to.window.to) %></summary>
  <div style="overflow-x:auto;"><table>
    <thead><tr><th>Month</th><th style="text-align:right;">Resignations</th><th style="text-align:right;">Terminations</th><th style="text-align:right;">Headcount</th></tr></thead>
    <tbody>
      <% to.months.forEach(function(x){ var blank = x.resignations == null && x.terminations == null && x.headcount == null; %>
      <tr<%= blank ? ' class="muted"' : '' %>>
        <td><%= mLbl(x.month) %></td>
        <td style="text-align:right;"><%= x.resignations == null ? 'not entered' : x.resignations %></td>
        <td style="text-align:right;"><%= x.terminations == null ? 'not entered' : x.terminations %></td>
        <td style="text-align:right;"><%= x.headcount == null ? 'not entered' : x.headcount %></td>
      </tr>
      <% }); %>
      <tr style="font-weight:700;border-top:2px solid var(--border);">
        <td>Rolling total</td>
        <td style="text-align:right;"><%= to.resignations == null ? '—' : to.resignations %></td>
        <td style="text-align:right;"><%= to.terminations == null ? '—' : to.terminations %></td>
        <td style="text-align:right;">avg <%= to.avg_headcount == null ? '—' : to.avg_headcount %></td>
      </tr>
    </tbody>
  </table></div>
  <p class="footnote" style="margin-bottom:0;">Entered on <a href="/admin/pc#turnover">P&amp;C Data</a>. A month with a headcount of zero, or none entered, produces no rate rather than a division.</p>
</details>
<% } %>


<% if (locals.survey) { %>
<%
  // ===== The eNPS survey trial =====
  // Anonymous responses collected through a magic link (services/survey.js). Which centre may be shown
  // at all is decided there, not here: a row arrives with enps === null when too few people answered.
  const sv = survey, svState = { upcoming: 'opens later', open: 'open now', closed: 'closed' }[sv.state];
  const svRounds = locals.surveyRounds || [];
%>
<h2 class="section-label" id="enps-survey">eNPS survey — <%= sv.round.name %> (<%= svState %>)</h2>
<div class="card">
  <div class="grid kpis">
    <div class="card stat"><div class="n"><%= sv.group.enps == null ? '—' : sv.group.enps %></div><div class="l">eNPS<span class="cap">all centres · promoters (9–10) − detractors (0–6)</span></div></div>
    <div class="card stat"><div class="n"><%= sv.group.n %></div><div class="l">Responses<span class="cap">of <%= sv.group.invited %> invited</span></div></div>
    <div class="card stat"><div class="n"><%= sv.group.response_rate == null ? '—' : sv.group.response_rate + '%' %></div><div class="l">Response rate<span class="cap">closes <%= sv.round.closes_on %></span></div></div>
    <div class="card stat"><div class="n"><%= sv.group.promoters %> / <%= sv.group.passives %> / <%= sv.group.detractors %></div><div class="l">Promoters / passives / detractors<span class="cap">passives count in the denominator only</span></div></div>
  </div>

  <% if (sv.centres.length) { %>
  <table style="margin-top:16px;">
    <thead><tr><th style="text-align:left;">Centre</th><th>eNPS</th><th>Responses</th><th>Invited</th><th>Response rate</th></tr></thead>
    <tbody>
      <% sv.centres.forEach(function(c){ %>
      <tr>
        <td><%= c.label %></td>
        <td style="text-align:center;font-weight:600;"><%= c.reportable ? c.enps : '—' %></td>
        <td style="text-align:center;"><%= c.reportable ? c.responses : '<' + sv.min_responses %></td>
        <td style="text-align:center;"><%= c.invited %></td>
        <td style="text-align:center;"><%= c.response_rate == null ? '—' : c.response_rate + '%' %></td>
      </tr>
      <% }); %>
    </tbody>
  </table>
  <% } %>

  <p class="footnote">
    A centre is reported only once at least <%= sv.min_responses %> people there have answered<% if (sv.withheld) { %> — <%= sv.withheld %> <%= sv.withheld === 1 ? 'centre is' : 'centres are' %> below that and <%= sv.withheld === 1 ? 'shows' : 'show' %> too few responses to report<% } %>. Those answers are still in the group figure above. Response rates are counts and are shown either way.
    Responses carry a centre, a score and the free text, and nothing that identifies who sent them — not even which invitation they came from.
  </p>
  <% if (svRounds.length > 1) { %>
  <p class="footnote">Round: <% svRounds.forEach(function(r, i){ %><% if(i) { %> · <% } %><a href="/pc?metric=enps&round=<%= r.id %><%= _q %>"<%= r.id===sv.round.id ? ' style="font-weight:700;"' : '' %>><%= r.name %></a><% }); %></p>
  <% } %>
</div>

<% if (locals.surveyComments && surveyComments.length) { %>
<%# Group level only, and admin/ops only. A comment read beside the centre it came from is a far smaller
    haystack than one read beside the whole group, so the centre is deliberately not shown with it. %>
<details class="card working">
  <summary style="cursor:pointer;font-weight:600;">What people wrote (<%= surveyComments.length %>) — all centres together</summary>
  <p class="footnote" style="margin-top:10px;">Not attributed to a centre. The survey asks people not to name colleagues.</p>
  <% surveyComments.forEach(function(c){ %>
    <div style="border-top:1px solid var(--border);padding:12px 0;">
      <div class="muted" style="font-size:12px;">Scored <%= c.score %></div>
      <% if (c.reason) { %><p style="margin:6px 0 0;"><%= c.reason %></p><% } %>
      <% if (c.other) { %><p style="margin:6px 0 0;" class="muted"><%= c.other %></p><% } %>
    </div>
  <% }); %>
</details>
<% } %>
<% } %>

<%
  // ===== Talent pipeline (Employment Hero payroll, counts only) =====
  // The owner's rules of 14 September are enforced in services/eh-talent.js; this section's job is to
  // STATE them, so nobody has to infer the basis from the numbers. Nothing here is a name: the whole
  // section is counts, a centre and an ATO cessation code.
  const tScoped = !!locals.scopedOwnaId;
  const tMine = talent ? (tScoped ? talent.centres.find(function(c){ return c.owna_id === locals.scopedOwnaId; }) : null) : null;
  const tHead = talent ? (tScoped ? (tMine ? tMine.headcount : 0) : talent.group.headcount) : 0;
  const tLeavers = talent ? (tScoped ? (tMine ? tMine.leavers12 : 0) : talent.group.leavers12) : 0;
  const tStarters = talent ? (tScoped ? (tMine ? tMine.starters12 : 0) : talent.group.starters12) : 0;
  const tNever = talent ? (tScoped ? (tMine ? tMine.never_started12 : 0) : talent.recon.window.never_started) : 0;
  const tVolPct = (talent && talent.totals.last12) ? Math.round(talent.totals.voluntary_last12 / talent.totals.last12 * 1000) / 10 : null;
  const tMonthLbl = talent ? mLbl(talent.month) : '';
  const num = function(v){ return v == null ? '—' : v; };
%>

<h2 class="section-label" id="talent">Talent — counted from payroll</h2>

<% if (!talent) { %>
<div class="card">
  <p class="muted" style="margin:0;">No talent counts have been taken yet. They populate on the nightly sync from Employment Hero, or on demand with <code>npm run talent-snapshot</code>.</p>
</div>
<% } else { %>

<div class="grid kpis">
  <div class="card stat"><div class="n"><%= tHead %></div><div class="l">Permanent headcount<span class="cap"><%= tScoped ? 'your centre' : 'group-wide' %> · as at <%= tMonthLbl %></span></div></div>
  <% if (!tScoped) { %>
  <div class="card stat"><div class="n"><%= talent.group.casual_headcount %></div><div class="l">Casuals<span class="cap">group-wide only — a casual works across every centre, so payroll's centre is an admin home, not where the hours were worked</span></div></div>
  <% } %>
  <div class="card stat"><div class="n"><%= tStarters %></div><div class="l">Starters<span class="cap">last 12 months</span></div></div>
  <div class="card stat"><div class="n"><%= tLeavers %></div><div class="l">Leavers<span class="cap">last 12 months, turnover basis</span></div></div>
  <% if (!tScoped && tVolPct != null) { %>
  <div class="card stat"><div class="n"><%= tVolPct %>%</div><div class="l">Voluntary<span class="cap">share of the last 12 months' leavers</span></div></div>
  <% } %>
</div>

<%# The reconciliation from raw terminations to turnover events. Kept, because the owner asked to be
    able to trace 145 down to 115, but behind a toggle: it is working, not a headline. %>
<details class="card working">
  <summary><strong>What counts as turnover</strong> — raw terminations, less casuals, less never-started</summary>
  <% if (!tScoped) { %>
  <p style="margin:0 0 10px;font-size:14px;">Payroll records <strong><%= talent.recon.all.raw %></strong> terminations across its whole history. Two groups are taken out before turnover is measured, and the same two are taken out of the headcount it is measured against:</p>
  <div style="overflow-x:auto;"><table>
    <thead><tr><th>Turnover basis</th><th style="text-align:right;">Last 12 months</th><th style="text-align:right;">All payroll history</th></tr></thead>
    <tbody>
      <tr><td>Terminations recorded in payroll</td><td style="text-align:right;"><%= talent.recon.window.raw %></td><td style="text-align:right;"><%= talent.recon.all.raw %></td></tr>
      <tr><td>less casual employees — a casual leaving is not turnover</td><td style="text-align:right;">−<%= talent.recon.window.casual %></td><td style="text-align:right;">−<%= talent.recon.all.casual %></td></tr>
      <tr><td>less people recorded as leaving on or before their start date — they never worked a day</td><td style="text-align:right;">−<%= talent.recon.window.never_started %></td><td style="text-align:right;">−<%= talent.recon.all.never_started %></td></tr>
      <tr style="font-weight:700;border-top:2px solid var(--border);"><td>Turnover events</td><td style="text-align:right;"><%= talent.recon.window.leavers %></td><td style="text-align:right;"><%= talent.recon.all.leavers %></td></tr>
    </tbody>
  </table></div>
  <% } else { %>
  <p style="margin:0 0 10px;font-size:14px;">Turnover here counts permanent staff at your centre only. Casual employees are excluded from both sides — they are not in the headcount and a casual leaving is not a leaver — and they are counted once group-wide rather than against any centre, because a casual works across all of them. <strong><%= tNever %></strong> <%= tNever === 1 ? 'person was' : 'people were' %> recorded as leaving on or before their start date in the last 12 months and <%= tNever === 1 ? 'is' : 'are' %> excluded too: they never worked a day.</p>
  <% } %>
  <p class="footnote" style="margin-top:12px;">
    <strong>There is no separate “resignation” code in payroll — a resignation is recorded as <em>Voluntary cessation</em></strong>, so the absence of a “Resignation” row below is not missing data.
    The exclusions are a test of the dates, not of tenure: someone who worked a fortnight and left is turnover.
    The turnover PERCENTAGE on this page is the owner's, entered per centre per month; these counts are payroll's, and answer a different question — why people left.
  </p>
</details>

<div class="card">
  <h2 style="margin-top:0;">Headcount &amp; role mix<% if (!tScoped) { %> by centre<% } %> — <%= tMonthLbl %></h2>
  <%# Between deploying the pay classification and the first payroll sync that fills it in, every mix is
      empty. Say that in a line rather than print seven zeros that do not add up to the headcount. %>
  <% var showMix = !talent.mix_pending; %>
  <% if (!showMix) { %><p class="muted" style="margin:-6px 0 12px;font-size:13px;">Role mix arrives with the next payroll sync.</p><% } %>
  <div style="overflow-x:auto;"><table>
    <thead><tr>
      <th>Centre</th>
      <th style="text-align:right;">Permanent</th>
      <% if (showMix) { talent.classLabels.forEach(function(r){ %><th style="text-align:right;"><%= r.label %></th><% }); } %>
      <th style="text-align:right;">Starters 12m</th>
      <th style="text-align:right;">Leavers 12m</th>
    </tr></thead>
    <tbody>
      <% talent.centres.forEach(function(c){ %>
      <tr>
        <td><% if (c.linkable) { %><a href="/centre/<%= c.owna_id %>"><strong><%= shortName(c.name) %></strong></a><% } else { %><strong><%= shortName(c.name) %></strong><% } %><% if (c.is_group_bucket) { %> <span class="muted" style="font-size:11px;">not a centre</span><% } %></td>
        <td style="text-align:right;font-weight:700;"><%= c.headcount %></td>
        <% if (showMix) { c.classes.forEach(function(r){ %><td style="text-align:right;<%= r.key === 'unclassified' && r.n ? 'font-weight:700;' : '' %>"><%= r.n %></td><% }); } %>
        <td style="text-align:right;"><%= c.starters12 %></td>
        <td style="text-align:right;"><%= c.leavers12 %></td>
      </tr>
      <% }); %>
      <% if (!tScoped) { %>
      <tr style="font-weight:700;border-top:2px solid var(--border);">
        <td>Group</td>
        <td style="text-align:right;"><%= talent.group.headcount %></td>
        <% if (showMix) { talent.group.classes.forEach(function(r){ %><td style="text-align:right;"><%= r.n %></td><% }); } %>
        <td style="text-align:right;"><%= talent.group.starters12 %></td>
        <td style="text-align:right;"><%= talent.group.leavers12 %></td>
      </tr>
      <% } %>
    </tbody>
  </table></div>
  <p class="footnote">
    Role is the person's <strong>pay classification</strong>, not their job title<% if (user.role === 'admin' || user.role === 'ops_manager') { %> — every scale and the category it maps to is listed under <a href="/admin/pay-scales">Pay classification</a><% } %>. <strong>Unclassified</strong> is a scale no rule maps yet, or none recorded: counted here, never hidden.
    Permanent staff only — <strong>no casual appears in this table</strong>.<% if (!tScoped) { %> The <%= talent.group.casual_headcount %> casuals are one group figure, below. (Casual <em>hours</em> per centre on <a href="/wages">Wages &amp; Margin</a> are a different measurement — those are real hours paid against that location, and they stand.)<% } else { %> Casuals are counted once group-wide rather than against any centre: a casual works across all of them. Casual <em>hours</em> paid against a centre are a different measurement and are unaffected.<% } %>
  </p>
</div>

<% if (!tScoped) { %>
<div class="card">
  <h2 style="margin-top:0;">Casuals — group-wide, <%= tMonthLbl %></h2>
  <%# Same guard as the permanent table above: until the first payroll sync fills the classification in,
      the casual mix is empty, and seven zeros against a real headcount is a breakdown that adds to 0. %>
  <% if (showMix) { %>
  <div style="overflow-x:auto;"><table>
    <thead><tr>
      <th>Casual staff</th>
      <% talent.classLabels.forEach(function(r){ %><th style="text-align:right;"><%= r.label %></th><% }); %>
    </tr></thead>
    <tbody>
      <tr>
        <td style="font-weight:700;"><%= talent.group.casual_headcount %> in total</td>
        <% talent.group.casual_classes.forEach(function(r){ %><td style="text-align:right;"><%= r.n %></td><% }); %>
      </tr>
    </tbody>
  </table></div>
  <% } else { %>
  <p style="margin:0 0 10px;"><strong><%= talent.group.casual_headcount %></strong> casuals in total. Role mix arrives with the next payroll sync.</p>
  <% } %>
  <p class="footnote">A casual works across every centre, so the centre payroll files them under is an administrative home rather than where the hours were worked — they are counted once here and against no centre.</p>
</div>
<% } %>

<div class="card">
  <h2 style="margin-top:0;">Why people left</h2>
  <div style="overflow-x:auto;"><table>
    <thead><tr>
      <th>Cessation reason (ATO Single Touch Payroll code)</th>
      <th style="text-align:right;">Last 12 months</th>
      <th style="text-align:right;">% of last 12</th>
      <th style="text-align:right;">Previous 12</th>
      <th style="text-align:right;">All history</th>
    </tr></thead>
    <tbody>
      <% talent.reasons.forEach(function(r){ %>
      <tr>
        <td><%= r.label %><% if (r.voluntary) { %> <span class="muted" style="font-size:11px;">(how a resignation is recorded)</span><% } %><% if (!r.known) { %> <span class="tag-fut" title="A code this dashboard has not seen before — carried through rather than dropped">new code</span><% } %></td>
        <td style="text-align:right;font-weight:<%= r.voluntary ? '700' : '400' %>;"><%= r.last12 %></td>
        <td style="text-align:right;"><%= talent.totals.last12 ? (Math.round(r.last12 / talent.totals.last12 * 1000) / 10) + '%' : '—' %></td>
        <td style="text-align:right;"><%= r.prior12 %></td>
        <td style="text-align:right;"><%= r.all %></td>
      </tr>
      <% }); %>
      <tr style="font-weight:700;border-top:2px solid var(--border);">
        <td>All terminations, turnover basis</td>
        <td style="text-align:right;"><%= talent.totals.last12 %></td>
        <td style="text-align:right;">100%</td>
        <td style="text-align:right;"><%= talent.reasons.reduce(function(a,r){return a+r.prior12;},0) %></td>
        <td style="text-align:right;"><%= talent.totals.all %></td>
      </tr>
      <tr>
        <td>of which voluntary</td>
        <td style="text-align:right;"><%= talent.totals.voluntary_last12 %></td>
        <td style="text-align:right;"><%= tVolPct == null ? '—' : tVolPct + '%' %></td>
        <td style="text-align:right;"><%= talent.reasons.filter(function(r){return r.voluntary;}).reduce(function(a,r){return a+r.prior12;},0) %></td>
        <td style="text-align:right;"><%= talent.totals.voluntary_all %></td>
      </tr>
    </tbody>
  </table></div>
  <p class="footnote">
    Casuals and never-started people are already out of every figure in this table. <strong>Transfer</strong> and <strong>Deceased</strong> are in the ATO code set and are listed at zero because this payroll has not used them — a zero is a measurement, a blank row is not. A code that is not in the set at all is carried through under its own name rather than dropped.
  </p>
</div>

<%
  const tLabels = talent.monthly.map(function(x){ return mLbl(x.month); });
  const tLc = { labels: tLabels, height: 220, series: [
    { name: 'Leavers', points: talent.monthly.map(function(x){ return x.leavers; }) },
    { name: 'Voluntary', points: talent.monthly.map(function(x){ return x.voluntary; }) },
    { name: 'Starters', points: talent.monthly.map(function(x){ return x.starters; }) },
  ] };
%>
<div class="card">
  <h2 style="margin-top:0;">Terminations over time<% if (tScoped) { %> — your centre<% } %></h2>
  <%- include('partials/linechart', { lc: tLc }) %>
  <p class="footnote">Monthly counts on the turnover basis: casuals and never-started people are not in any of these three lines. Voluntary is the subset of leavers recorded as <em>Voluntary cessation</em>.</p>
</div>

<%# Removed 16 September 2026, with the owner's decision to enter turnover himself: the payroll-derived
    turnover percentage, and the card comparing it with the HR spreadsheet. There is one turnover figure
    now — his, above — so there was nothing left to compare. Payroll's leaver COUNTS and the breakdown by
    cessation code stay: they answer why people left, which no entered number does. %>

<% if (locals.talentSync) { %>
<p class="footnote">
  Payroll people counts last <%= talentSync.status === 'ok' ? 'refreshed' : 'attempted' %> <%= talentSync.last_attempt || 'never' %><% if (talentSync.status && talentSync.status !== 'ok') { %> — <strong><%= talentSync.status %></strong>: <%= talentSync.detail %><% } %>. Counts only: this dashboard stores no staff name, employee number or date of birth.
</p>
<% } %>

<% } %>

<%- include('partials/footer') %>
