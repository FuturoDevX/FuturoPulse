<%- include('partials/header', { title: 'Continuation of Enrolment' }) %>
<%
  // Continuation of Enrolment — the 2027 campaign view (Nov 2026 → Apr 2027). Counts only, no names:
  // a viewer may open this page. Every figure states its method beside it.
  const shortName = (n) => (n||'').replace(/Futuro Childcare (and|&) Education\s*-?\s*/i,'').replace('Futuro ','').trim();
  const MN = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const mLong  = (mo) => MN[Number(mo.slice(5,7))-1] + ' ' + mo.slice(0,4);
  const mShort = (mo) => MN[Number(mo.slice(5,7))-1] + ' ' + mo.slice(2,4);
  const dLong  = (d) => d ? new Date(d+'T00:00:00Z').toLocaleDateString('en-AU',{day:'numeric',month:'short',year:'numeric'}) : '';
  const fmt  = (n) => Math.round(Number(n)||0).toLocaleString('en-AU');
  const sgn  = (n) => (Number(n)||0) > 0 ? '−' + fmt(n) : fmt(n);
  // Targets are PER CENTRE (services/metrics.js occupancyTargets → labour_budget.budget_occ, 'default' week).
  // TGT is only the group fallback for a centre with nothing stored; GTGT is the places-weighted group
  // target. Nothing on this page may be coloured against a single number any more, so tone() takes the
  // target it is judging against and every caller passes the right one.
  const TGT  = coe.target_pct;
  const GTGT = coe.group.target_pct;
  const pctStr = (n) => (Number(n) % 1 === 0 ? String(Number(n)) : Number(n).toFixed(1)) + '%';
  const tone = (p, t) => { const g = (t == null ? TGT : t); return p >= g ? 'good' : (p >= g - 10 ? 'warn' : 'bad'); };
  const W    = (v, avail) => avail > 0 ? Math.max(0, Math.min(100, v / avail * 100)).toFixed(1) : '0';
  const canEditTargets = ['admin','ops_manager'].includes(user.role);
  const mixedTargets = coe.centres.some((c) => c.target_pct !== coe.centres[0].target_pct);
  const overTarget = coe.centres.filter((c) => c.target_pct > 100);
  // Anchor month: February 2027, the first full month after the school-year transition.
  let ai = coe.months.findIndex((x) => x.month === '2027-02');
  if (ai < 0) ai = Math.min(3, coe.months.length - 1);
  const am = coe.months[ai], ga = coe.group.months[ai];
  const openMonth = (c) => c.opening_month ? MN[c.opening_month-1] + ' ' + c.opening_year : (c.opening_year || 'soon');
  // The measured half: null until the first nightly snapshot has run (services/snapshot.js runCoeSnapshot).
  const ms = coe.measured;
  const mi = ms ? ms.months.findIndex((x) => x.month === am.month) : -1;
  const mm = mi >= 0 ? ms.months[mi] : null;
  // A snapshot night that failed for some centres covers only the ones it reached. Every measured figure
  // below is then a part of the group, not the group, and has to say so wherever it is printed.
  const msPartial = !!(ms && ms.partial);
  const msCover = ms ? ms.centres.length + ' of ' + ms.centres_expected + ' centres measured' : '';
  const msMissing = ms ? (ms.centres_missing || []).map((c) => shortName(c.name) + (c.last_measured ? ' last measured ' + dLong(c.last_measured) : ' never measured')).join(', ') : '';
  const mixBand = (o, d) => (o.mix.find((x) => x.days_per_week === d) || { children: 0, child_days: 0 });
%>

<div class="page-head">
  <div>
    <h1>Continuation of Enrolment
      <% if (ms) { %><span class="badge<%= msPartial ? ' warn' : '' %>">Measured continuing count as at <%= dLong(ms.snapshot_date) %><%= msPartial ? ' · ' + msCover : '' %></span>
      <% } else { %><span class="badge warn">First release — continuing count and booking mix follow</span><% } %>
    </h1>
    <p class="sub">The 2027 campaign view · <%= mLong(coe.window.first) %> – <%= mLong(coe.window.last) %> · child-days booked against child-days available, per centre · counts only, no child, family or staff names</p>
  </div>
</div>

<%# The three-limits card was a full-width warning read once and skipped thereafter. The January
    crossover is now a note on the January column, and the leaver-days caveat sits beside the leaver
    column where the number it qualifies actually appears. The rest is on /coe/method. %>
<p class="sub" style="margin:-6px 0 18px;max-width:78ch;">
  <% if (mm) { %>
    Of the <strong><%= fmt(mm.enrolled) %></strong> children enrolled today<%= msPartial ? ' at the ' + msCover : '' %>,
    <strong><%= fmt(mm.continuing) %></strong> hold bookings that reach <%= mLong(am.month) %>,
    <strong><%= fmt(mm.not_confirmed) %></strong> have none that far out yet and
    <strong><%= fmt(mm.leaving) %></strong> have a finish date before it.
    The projection further down is a ceiling: it assumes everyone without a finish date stays.
    <% if (msPartial) { %><br><strong class="bad-text">These counts cover <%= msCover %> — <%= msMissing %> — while the projection covers every centre, so the two halves of this page are not the same group of children.</strong><% } %>
  <% } else { %>
    Every percentage here is a ceiling: it assumes every family without a finish date stays. The measured
    count of children who actually hold bookings starts from the first nightly run.
  <% } %>
  <a class="row-link" href="/coe/method">How these are calculated &rarr;</a>
</p>

<div class="card" id="targets">
  <h2 style="margin-top:0;">What each centre is measured against
    <span class="muted" style="font-weight:400;font-size:13px;">· <%= mixedTargets ? 'the targets are not the same number, so neither are the colours' : 'every centre is on the same target' %></span>
  </h2>
  <p class="sub" style="margin-bottom:14px;">
    <%# Was five lines explaining that the target is per centre, which the table then shows. The one
        thing a reader cannot see from the table is that this is the SAME stored value the wage page
        uses, so editing it in either place moves both. That is what is left. %>
    Each centre is judged against its own target. These are the same stored values the
    <a href="/wages">wage budgets</a> use, so changing one moves both.
  </p>
  <div style="overflow-x:auto;"><table>
    <thead>
      <tr>
        <th>Centre</th><th class="num">Approved places</th><th class="num">Target</th><th>Target comes from</th>
        <th class="num" title="Booked child-days in the run-rate week ÷ (approved places × 5)">Booked, run-rate week</th>
        <th class="num" title="Child-days actually attended in the same week ÷ (approved places × 5)">Attended, same week</th>
      </tr>
    </thead>
    <tbody>
      <% coe.centres.forEach(function(c){ %>
        <tr>
          <td><a class="row-link" href="/centre/<%= c.owna_id %>"><%= shortName(c.name) %></a></td>
          <td class="num"><%= c.places %></td>
          <td class="num"><strong><%= pctStr(c.target_pct) %></strong></td>
          <td>
            <% if (c.target_source === 'centre') { %>
              its own stored target <span class="muted" style="font-size:11.5px;">· saved against the payroll centre “<%= c.target_eh_centre %>”</span>
            <% } else { %>
              <span class="warn-text">group default</span> <span class="muted" style="font-size:11.5px;">· no target stored for this centre yet</span>
            <% } %>
          </td>
          <td class="num"><%= fmt(c.run_week_days) %><br><span class="muted" style="font-size:11.5px;"><%= c.run_week_pct %>% of places × 5</span></td>
          <td class="num"><%= fmt(c.run_week_attended) %><br><span class="muted" style="font-size:11.5px;"><%= c.run_week_attended_pct %>% of places × 5</span></td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr class="total-row">
        <td>All operating centres</td>
        <td class="num"><%= coe.group.places %></td>
        <td class="num"><strong><%= pctStr(GTGT) %></strong></td>
        <td>weighted by approved places <span class="muted" style="font-size:11.5px;">· not the average of the four numbers</span></td>
        <td class="num"><%= fmt(coe.group.run_week_days) %><br><span class="muted" style="font-size:11.5px;"><%= coe.group.run_week_pct %>%</span></td>
        <td class="num"><%= fmt(coe.group.run_week_attended) %><br><span class="muted" style="font-size:11.5px;"><%= coe.group.run_week_attended_pct %>%</span></td>
      </tr>
    </tfoot>
  </table></div>
  <% if (overTarget.length) { %>
  <p class="footnote" style="border-left:3px solid var(--sage);padding-left:10px;">
    <strong>A target above 100% of approved places is not a mistake.</strong>
    The measure it applies to is <em>booked</em> child-days ÷ (approved places × operating days), and a booking counts
    whether or not the child turns up — an absent child still holds the place — so bookings run above the children
    actually in the building and the ratio can pass 100% while the number attending does not. A centre is over its
    licence only if more children <em>attend</em> on the same day than it is licensed for, and in the run-rate week
    <%= overTarget.map(function(c){ return shortName(c.name) + ' booked ' + c.run_week_pct + '% of its place-days and attended ' + c.run_week_attended_pct + '%'; }).join(', ') %>.
    It is <strong>not</strong> reached by part-time families sharing a place across the week — that is what makes
    <em>children per place</em> greater than one, and it cannot lift days filled, because a part-time child books
    fewer child-days, not more.
  </p>
  <% } %>
  <p class="footnote" style="margin-bottom:0;">
    <%= coe.targets_stored %> of the <%= coe.centres.length %> operating centres have a target stored<%= coe.targets_default ? '; ' + coe.targets_default + ' fall back to the ' + pctStr(coe.target_default_pct) + ' group default' : '' %>.
    <% if (canEditTargets) { %><a class="row-link" href="<%= coe.targets_editable_at %>#targets"><strong>Set targets →</strong></a> They live on the Approved places page, beside the licensed count they are a percentage of, and on the Wage budgets page — both write the same row.<% } else { %>Targets are maintained by an administrator or the operations manager on the Approved places page.<% } %>
  </p>
</div>

<%# Reordered 15 Sept 2026: the measured continuing count leads and the run-rate projection follows.
    The page opened with the projection — a model that assumes every family without a finish date
    stays — while the count of children who actually hold bookings sat two hundred lines below it.
    The measured number is the one a director can act on; the projection is the ceiling around it,
    and reads better as context than as the headline. %>
<% if (ms && mm) { %>
<div class="card">
  <h2 style="margin-top:0;">The measured continuing count <span class="muted" style="font-weight:400;font-size:13px;">· counted from the bookings themselves, not from the run rate</span></h2>
  <p class="sub" style="margin-bottom:14px;">Of the children enrolled today, how many hold bookings that reach into each campaign month. <strong>Continuing</strong> holds at least one booked day in the month. <strong>Not yet confirmed</strong> has none that far out and no finish date — that is the campaign's working list, not a prediction that they leave. <strong>Leaving</strong> has a finish date before the month starts. Counts of children, taken from the snapshot of <%= dLong(ms.snapshot_date) %>.</p>
  <div class="grid kpis" style="margin-bottom:18px;">
    <div class="card stat"><div class="n"><%= fmt(mm.continuing) %></div><div class="l">Children continuing into <%= mLong(am.month) %><span class="cap"><%= mm.continuing_pct %>% of the <%= fmt(mm.enrolled) %> enrolled today<%= msPartial ? ' · ' + msCover : '' %><%= mm.centres_beyond ? ' · ' + mm.centres_beyond + ' centre(s) excluded, bookings stop earlier' : '' %></span></div></div>
    <div class="card stat"><div class="n warn-text"><%= fmt(mm.not_confirmed) %></div><div class="l">Not yet confirmed<span class="cap">no bookings recorded that far out and no finish date · worth about <%= fmt(mm.not_confirmed_days) %> child-days at their own booking pattern</span></div></div>
    <div class="card stat"><div class="n bad-text"><%= fmt(mm.leaving) %></div><div class="l">Leaving before <%= mLong(am.month) %><span class="cap">finish date already set in OWNA · <%= fmt(mm.leaving_days) %> child-days at their own pattern, not the centre average</span></div></div>
    <div class="card stat"><div class="n"><%= fmt(mm.continuing_days) %></div><div class="l">Child-days already booked in <%= mLong(am.month) %><span class="cap">of <%= fmt(mm.available_days) %> available · the run rate projects <%= fmt(ga.projected_days) %></span></div></div>
  </div>
  <div style="overflow-x:auto;"><table>
    <thead>
      <tr>
        <th>Centre</th><th class="num">Enrolled now</th>
        <% coe.months.forEach(function(x){ %><th class="num"><%= mShort(x.month) %></th><% }); %>
      </tr>
    </thead>
    <tbody>
      <% ms.centres.forEach(function(c){ %>
        <tr>
          <td><a class="row-link" href="/centre/<%= c.owna_id %>"><%= shortName(c.name) %></a><br><span class="muted" style="font-size:11.5px;"><%= c.avg_days_per_child.toFixed(1) %> days per child per week</span></td>
          <td class="num"><%= fmt(c.enrolled) %></td>
          <% c.months.forEach(function(x){ %>
            <% if (!x.in_group) { %>
              <td class="num muted" title="This centre has no bookings after <%= dLong(c.last_booking_date) %> — not measurable, and not a collapse">—</td>
            <% } else { %>
              <td class="num" title="<%= x.continuing %> continuing · <%= x.not_confirmed %> not yet confirmed · <%= x.leaving %> leaving · <%= fmt(x.continuing_days) %> child-days booked"><strong><%= fmt(x.continuing) %></strong><br><span class="muted" style="font-size:11.5px;"><%= x.continuing_pct %>%</span></td>
            <% } %>
          <% }); %>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr class="total-row">
        <td><%= msPartial ? msCover : 'All measured centres' %></td>
        <td class="num"><%= fmt(ms.months[0] ? ms.months[0].enrolled : 0) %></td>
        <% ms.months.forEach(function(x){ %>
          <td class="num" title="<%= x.continuing %> continuing · <%= x.not_confirmed %> not yet confirmed · <%= x.leaving %> leaving"><strong><%= fmt(x.continuing) %></strong><br><span class="muted" style="font-size:11.5px;"><%= x.continuing_pct %>%<%= x.centres_beyond ? ' · ' + x.centres_measured + ' of ' + (x.centres_measured + x.centres_beyond) : '' %></span></td>
        <% }); %>
      </tr>
    </tfoot>
  </table></div>
  <% if (msPartial) { %>
    <p class="footnote" style="border-left:3px solid var(--warn);padding-left:10px;">
      <strong>This is <%= msCover %> — <%= msMissing %>.</strong> The snapshot of <%= dLong(ms.snapshot_date) %> did not reach every centre (OWNA refused the pull, or returned no children), and no earlier night covers them all either, so every measured figure in this section and the booking mix below — the enrolled count, the continuing count, the child-days and the licensed places they are measured against — is the sum of the centres above and no others. It is not a fall in enrolments. The run rate and the projection higher up the page are unaffected: they come from the nightly occupancy pull, not from this one.
    </p>
  <% } %>
  <% ms.stops.forEach(function(c){ %>
    <p class="footnote" style="border-left:3px solid var(--warn);padding-left:10px;">
      <strong><%= shortName(c.name) %>: its forward bookings stop on <%= dLong(c.last_booking_date) %></strong><%= c.stops_together ? ' — ' + fmt(c.horizon_children) + ' of its ' + fmt(c.enrolled) + ' children have their last booking in that final week' : '' %>. That is how the centre sets recurring bookings in OWNA, not <%= fmt(c.enrolled) %> families leaving: OWNA rolls recurring bookings forward indefinitely for most centres, and a centre that ends them on a fixed date has nothing to count after it. Months its bookings do not cover — including one it stops part-way into — are shown as “—”, are left out of the group row, and stay on the run-rate projection until the centre director confirms how the bookings are set (outstanding item 7).
    </p>
  <% }); %>
  <p class="footnote" style="margin-bottom:0;"><strong>Enrolled now</strong> is the children with at least one booking in the reference week <%= dLong(ms.centres[0].week.from) %> – <%= dLong(ms.centres[0].week.to) %> — the week with the most children booked in the forward pull, so a holiday week cannot read as a collapse. Public holidays are excluded from every child-day here, as they are everywhere else on this page. <strong>The group row covers only the centres whose bookings reach that month</strong>, so it is not comparable across a month where a centre drops out. Nothing per-child is stored: the snapshot writes counts, and OWNA keeps the records of who the children are.</p>
</div>

<div class="card">
  <h2 style="margin-top:0;">Booking mix <span class="muted" style="font-weight:400;font-size:13px;">· how many days a week each family is booked, and what that does to days filled</span></h2>
  <p class="sub" style="margin-bottom:14px;">A child on three days a week fills a place on three days and leaves it free on two. This is why the number of children on the roll and the share of the week actually filled are different numbers, and why the second one is the one the campaign has to move. Measured over <%= dLong(ms.centres[0].week.from) %> – <%= dLong(ms.centres[0].week.to) %>.</p>
  <div class="two-col" style="margin-bottom:18px;">
    <div>
      <h3 style="margin:0 0 10px;font-size:14px;color:var(--brand-ink);"><%= msPartial ? msCover : 'All operating centres' %> <span class="muted" style="font-weight:400;">· <%= fmt(ms.group.mix_children) %> children, <%= fmt(ms.group.mix_child_days) %> child-days a week</span></h3>
      <% var gmax = Math.max.apply(null, ms.group.mix.map(function(b){ return b.children; }).concat([1])); %>
      <div class="coe-mix">
        <% ms.group.mix.forEach(function(b){ %><div style="height:<%= Math.round(b.children / gmax * 100) %>%;" title="<%= b.children %> children booked <%= b.days_per_week %> day<%= b.days_per_week === 1 ? '' : 's' %> a week"></div><% }); %>
      </div>
      <div class="coe-mix-x">
        <% ms.group.mix.forEach(function(b){ %><span><%= b.days_per_week %> day<%= b.days_per_week === 1 ? '' : 's' %><br><strong><%= fmt(b.children) %></strong></span><% }); %>
      </div>
    </div>
    <div>
      <h3 style="margin:0 0 10px;font-size:14px;color:var(--brand-ink);">The roll against the week</h3>
      <p style="font-size:13px;margin:0 0 8px;"><strong><%= fmt(ms.group.mix_children) %> children</strong> share the <%= fmt(ms.group.places) %> licensed places, because most attend part-time — <strong><%= (ms.group.places_filled_pct / 100).toFixed(2) %></strong> children to a place. Together they book <strong><%= fmt(ms.group.mix_child_days) %></strong> of the <%= fmt(ms.group.places * 5) %> child-days a week those places could carry — <strong class="<%= tone(ms.group.days_filled_pct, ms.group.target_pct) + '-text' %>"><%= ms.group.days_filled_pct %>%</strong> of the week, against the <%= pctStr(ms.group.target_pct) %> group target.</p>
      <p style="font-size:13px;margin:0;">The group averages <strong><%= ms.group.avg_days_per_child.toFixed(2) %> days per child per week</strong>. Every extra day a week taken by an existing family is worth as much as <%= ms.group.avg_days_per_child >= 1 ? (1 / ms.group.avg_days_per_child).toFixed(2) : '—' %> of a new enrolment, and costs no marketing.</p>
    </div>
  </div>
  <div style="overflow-x:auto;"><table>
    <thead>
      <tr>
        <th>Centre</th><th class="num">Places</th><th class="num">Children</th>
        <% [1,2,3,4,5].forEach(function(d){ %><th class="num"><%= d %> day<%= d === 1 ? '' : 's' %></th><% }); %>
        <th class="num">Child-days / week</th><th class="num">Avg days</th><th class="num">Children per place</th><th class="num">Target</th><th class="num">Days filled</th>
      </tr>
    </thead>
    <tbody>
      <% ms.centres.forEach(function(c){ %>
        <tr>
          <td><a class="row-link" href="/centre/<%= c.owna_id %>"><%= shortName(c.name) %></a></td>
          <td class="num"><%= fmt(c.places) %></td>
          <td class="num"><%= fmt(c.mix_children) %></td>
          <% [1,2,3,4,5].forEach(function(d){ var b = mixBand(c, d); %><td class="num"><%= fmt(b.children) %><br><span class="muted" style="font-size:11.5px;"><%= fmt(b.child_days) %> days</span></td><% }); %>
          <td class="num"><strong><%= fmt(c.mix_child_days) %></strong></td>
          <td class="num"><%= c.avg_days_per_child.toFixed(2) %></td>
          <td class="num"><%= (c.places_filled_pct / 100).toFixed(2) %></td>
          <td class="num"><%= pctStr(c.target_pct) %><% if (c.target_source !== 'centre') { %><br><span class="muted" style="font-size:11.5px;">group default</span><% } %></td>
          <td class="num coe-pct <%= tone(c.days_filled_pct, c.target_pct) %>" title="measured against <%= shortName(c.name) %>'s own target of <%= pctStr(c.target_pct) %>"><%= c.days_filled_pct %>%</td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr class="total-row">
        <td><%= msPartial ? msCover : 'All operating centres' %></td>
        <td class="num"><%= fmt(ms.group.places) %></td>
        <td class="num"><%= fmt(ms.group.mix_children) %></td>
        <% ms.group.mix.forEach(function(b){ %><td class="num"><%= fmt(b.children) %><br><span class="muted" style="font-size:11.5px;"><%= fmt(b.child_days) %> days</span></td><% }); %>
        <td class="num"><%= fmt(ms.group.mix_child_days) %></td>
        <td class="num"><%= ms.group.avg_days_per_child.toFixed(2) %></td>
        <td class="num"><%= (ms.group.places_filled_pct / 100).toFixed(2) %></td>
        <td class="num"><%= pctStr(ms.group.target_pct) %></td>
        <td class="num coe-pct <%= tone(ms.group.days_filled_pct, ms.group.target_pct) %>"><%= ms.group.days_filled_pct %>%</td>
      </tr>
    </tfoot>
  </table></div>
  <p class="footnote" style="margin-bottom:0;"><strong>Days per week</strong> is each child's own distinct booked days in the reference week, so it is what OWNA holds rather than what a family once asked for. A family booked fortnightly counts at the days of that week only. <strong>Children per place</strong> = children on the roll ÷ licensed places. It is above 1 wherever families attend part-time and share a place across the week, which is normal and not a breach; a centre is over its licence only if more children attend on the same day than it is licensed for. <strong>Days filled</strong> = child-days a week ÷ (licensed places × 5), and it is the number the campaign has to move — it is also the measure each centre's stored target is set against, which is why the Target column sits beside it. Days filled passes 100% only when more child-days are BOOKED than the licence has place-days, which happens because a booked child who is absent still holds the place — it is the children who <em>attend</em> on a day that the licence limits; part-time sharing is what lifts <em>children per place</em> above 1 and it cannot lift days filled, because a part-time child books fewer child-days, not more.</p>
</div>
<% } else { %>
<div class="card" style="border-left:3px solid var(--muted);">
  <h2 style="margin-top:0;">The measured continuing count and booking mix</h2>
  <p class="sub" style="margin-bottom:0;">Not on this page yet: no snapshot of forward bookings has been taken. The nightly run at 2:15am Sydney takes the first one — or <code>npm run coe-snapshot</code> takes it now — and from then on this page shows, beside the run rate, how many of the children enrolled today hold bookings reaching each campaign month, how many are not yet confirmed, how many are leaving, and how many families are booked 1, 2, 3, 4 or 5 days a week. Everything above works as it does today in the meantime.</p>
</div>
<% } %>

<%# The run-rate projection: the ceiling. It assumes every family without a finish date continues,
    which is why it sits under the measured count rather than above it. %>
<div class="grid kpis">
  <div class="card stat"><div class="n"><%= fmt(ga.available_days) %></div><div class="l">Child-days available in <%= mLong(am.month) %><span class="cap"><%= coe.group.places %> approved places × <%= am.operating_days %> operating days</span></div></div>
  <div class="card stat"><div class="n <%= tone(ga.pct, GTGT) + '-text' %>"><%= ga.pct %>%</div><div class="l">Projected filled · <%= fmt(ga.projected_days) %> days<span class="cap">run rate − leaver days + firm backfill · against the group target of <%= pctStr(GTGT) %>, the centre targets weighted by approved places</span></div></div>
  <div class="card stat"><div class="n bad-text"><%= sgn(ga.leaver_days) %></div><div class="l">Child-days falling away<span class="cap"><%= ga.leavers_to_date %> children with a finish date set by <%= mLong(am.month) %>. The count is exact; the days are estimated at each centre's average booking pattern, so a centre losing five-day families loses more than shown</span></div></div>
  <div class="card stat"><div class="n good-text">+<%= fmt(ga.firm_days) %></div><div class="l">Child-days of firm backfill<span class="cap"><%= ga.firm_children %> children at Offer Accepted or Pre-Offered, from their expected start date<%= ga.days_unknown ? ' · ' + ga.days_unknown + ' of them with no requested days recorded, valued at their centre average' : '' %></span></div></div>
  <div class="card stat"><div class="n"><%= ga.gap_days > 0 ? fmt(ga.gap_days) : '—' %></div><div class="l">Gap to target<span class="cap">child-days in <%= mLong(am.month) %> against <%= fmt(ga.target_days) %> targeted (<%= pctStr(GTGT) %> of available)<%= ga.gap_days > 0 && am.operating_days ? ' · about ' + Math.round(ga.gap_days / (am.operating_days / 5) / 3) + ' children at 3 days a week' : ' · the projection is at or above target' %><%= ga.shortfall_days > 0 ? ' · ' + fmt(ga.shortfall_days) + ' counted centre by centre, since a centre over its target cannot fill a seat at one under it' : '' %></span></div></div>
</div>

<div class="card">
  <h2 style="margin-top:0;"><%= mLong(am.month) %>, the anchor month <span class="muted" style="font-weight:400;font-size:13px;">· each bar is that centre's available child-days</span></h2>
  <% coe.centres.forEach(function(c){ var x = c.months[ai]; var keep = Math.max(0, x.run_rate_days - x.leaver_days); %>
    <div class="coe-bar-row">
      <div class="coe-bar-name"><%= shortName(c.name) %><span><%= c.places %> places · <%= am.operating_days %> days · <%= fmt(x.available_days) %> days available · target <%= pctStr(c.target_pct) %><%= c.target_source === 'centre' ? '' : ' (group default)' %></span></div>
      <div class="coe-track">
        <div class="coe-seg keep" style="width:<%= W(keep, x.available_days) %>%;" title="Run rate less leavers: <%= fmt(keep) %> days"></div>
        <div class="coe-seg firm" style="width:<%= W(x.firm_days, x.available_days) %>%;" title="Firm backfill: <%= fmt(x.firm_days) %> days"></div>
        <div class="coe-seg lost" style="width:<%= W(x.leaver_days, x.available_days) %>%;" title="Days falling away: <%= fmt(x.leaver_days) %> days"></div>
        <%# The track is clipped at 100%, so a target above 100 sits on the right-hand edge and says so. %>
        <div class="coe-target" style="left:<%= Math.min(100, c.target_pct) %>%;" title="<%= shortName(c.name) %> target <%= pctStr(c.target_pct) %><%= c.target_pct > 100 ? ' — beyond the end of the track, which stops at 100%' : '' %>"></div>
      </div>
      <div class="coe-bar-val <%= tone(x.pct, c.target_pct) + '-text' %>"><%= x.pct %>%<span><%= fmt(x.projected_days) %> days · target <%= pctStr(c.target_pct) %></span></div>
    </div>
  <% }); %>
  <div class="coe-legend">
    <span><i style="background:var(--brand);"></i>Run rate, less the children with finish dates</span>
    <span><i style="background:var(--fill-good);"></i>Firm backfill (Offer Accepted / Pre-Offered)</span>
    <span><i class="coe-seg lost" style="width:14px;height:10px;"></i>Days falling away (shown beyond the fill, not inside it)</span>
    <span><i style="background:var(--warn);width:3px;"></i>That centre's own target<%= mixedTargets ? ' — a different mark on each row' : '' %></span>
  </div>
  <p class="footnote">The track is clipped at 100%: a centre above target fills it and the figure beside the bar carries the real number. Each row's target mark is its own — <%= coe.centres.map(function(c){ return shortName(c.name) + ' ' + pctStr(c.target_pct); }).join(', ') %><% if (overTarget.length) { %>, and a target over 100% sits on the right-hand edge because the track cannot draw past it<% } %>.</p>
</div>

<div class="card">
  <h2 style="margin-top:0;">Month by month <span class="muted" style="font-weight:400;font-size:13px;">· projected child-days filled as a share of child-days available</span></h2>
  <div style="overflow-x:auto;"><table>
    <thead>
      <tr>
        <th>Centre</th><th class="num">Places</th><th class="num">Target</th><th class="num">Run rate / week</th><th class="num">Leaving by <%= mShort(coe.window.last) %></th>
        <% coe.months.forEach(function(x){ %><th class="num"><%= mShort(x.month) %><br><span style="font-weight:400;text-transform:none;letter-spacing:0;"><%= x.operating_days %> days</span></th><% }); %>
      </tr>
    </thead>
    <tbody>
      <% coe.centres.forEach(function(c){ %>
        <tr>
          <td><a class="row-link" href="/centre/<%= c.owna_id %>"><%= shortName(c.name) %></a><br><span class="muted" style="font-size:11.5px;"><%= c.enrolled %> enrolled · <%= c.avg_days_per_child.toFixed(1) %> days per child</span></td>
          <td class="num"><%= c.places %></td>
          <td class="num"><strong><%= pctStr(c.target_pct) %></strong><% if (c.target_source !== 'centre') { %><br><span class="muted" style="font-size:11.5px;">group default</span><% } %></td>
          <td class="num"><%= fmt(c.run_week_days) %></td>
          <td class="num bad-text"><%= c.months[coe.months.length-1].leavers_to_date %></td>
          <% c.months.forEach(function(x){ %><td class="num coe-pct <%= tone(x.pct, c.target_pct) %>" title="<%= fmt(x.projected_days) %> of <%= fmt(x.available_days) %> days · <%= shortName(c.name) %> is measured against <%= pctStr(c.target_pct) %>"><%= x.pct %>%</td><% }); %>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr class="total-row">
        <td>All operating centres</td>
        <td class="num"><%= coe.group.places %></td>
        <td class="num"><strong><%= pctStr(GTGT) %></strong></td>
        <td class="num"><%= fmt(coe.group.run_week_days) %></td>
        <td class="num"><%= coe.group.months[coe.months.length-1].leavers_to_date %></td>
        <% coe.group.months.forEach(function(x){ %><td class="num coe-pct <%= tone(x.pct, x.target_pct) %>" title="<%= fmt(x.projected_days) %> of <%= fmt(x.available_days) %> days · measured against the weighted group target <%= pctStr(x.target_pct) %>"><%= x.pct %>%</td><% }); %>
      </tr>
    </tfoot>
  </table></div>
  <p class="footnote" style="margin-bottom:0;">Each centre is coloured against <strong>its own target</strong> (listed above): green at or above it, amber within ten points, red below. Two centres on the same percentage can be different colours, which is the point. Pre-opening centres are not in this table — no run rate, no licensed places yet.</p>
</div>


<div class="card">
  <h2 style="margin-top:0;">The working, group total by month</h2>
  <div style="overflow-x:auto;"><table>
    <thead>
      <tr>
        <th>Month</th><th class="num">Operating days</th><th class="num">Available</th><th class="num">Run rate</th>
        <th class="num">Leavers</th><th class="num">Leaver days</th><th class="num">Firm starters</th><th class="num">Firm days</th>
        <th class="num">All-pipeline days</th><th class="num">Projected</th><th class="num">Target</th><th class="num">% filled</th><th class="num" title="Targeted child-days − projected, at the weighted group target">Gap to target</th><th class="num" title="The same shortfall counted centre by centre: a centre over its own target cannot fill a seat at one under it">Centre shortfall</th>
      </tr>
    </thead>
    <tbody>
      <% coe.group.months.forEach(function(x){ %>
        <tr class="<%= x.month === am.month ? 'coe-anchor' : '' %>">
          <td><%= mLong(x.month) %><% if (x.month === am.month) { %> — anchor<% } else if (x.month === '2027-01') { %> <span title="Leavers are still present until late January while starters are added from their start dates, so the two groups overlap inside the month. February is the first clean month.">— crossover, reads high</span><% } %></td>
          <td class="num"><%= x.operating_days %></td>
          <td class="num"><%= fmt(x.available_days) %></td>
          <td class="num"><%= fmt(x.run_rate_days) %></td>
          <td class="num"><%= x.leavers_to_date %><% if (x.leavers_in_month) { %><span class="muted"> (<%= x.leavers_in_month %> this month)</span><% } %></td>
          <td class="num bad-text"><%= sgn(x.leaver_days) %></td>
          <td class="num"><%= x.firm_children %><% if (x.days_unknown) { %><span class="muted"> (<%= x.days_unknown %> est.)</span><% } %></td>
          <td class="num good-text">+<%= fmt(x.firm_days) %></td>
          <td class="num muted"><%= fmt(x.all_days) %></td>
          <td class="num"><strong><%= fmt(x.projected_days) %></strong></td>
          <td class="num"><%= fmt(x.target_days) %><br><span class="muted" style="font-size:11.5px;"><%= pctStr(x.target_pct) %></span></td>
          <td class="num coe-pct <%= tone(x.pct, x.target_pct) %>"><%= x.pct %>%</td>
          <td class="num"><%= x.gap_days > 0 ? fmt(x.gap_days) : '—' %></td>
          <td class="num"><%= x.shortfall_days > 0 ? fmt(x.shortfall_days) : '—' %></td>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
  <p class="footnote" style="margin-bottom:0;">Every column is child-days unless it says otherwise. <strong>Available</strong> = licensed places × operating days. <strong>Run rate</strong> = the last complete week's booked child-days × (operating days ÷ 5). <strong>Leavers</strong> is a headcount; <strong>leaver days</strong> values them at the centre average from the day after each finish date. <strong>Firm days</strong> counts Offer Accepted and Pre-Offered only; <strong>all-pipeline days</strong> adds every other status (waitlist, tours, new families) and is shown for context — it is <em>not</em> in the projection. <strong>Projected</strong> = run rate − leaver days + firm days. <strong>(n est.)</strong> beside a starter count is how many of those children have no requested days recorded in LineLeader: they are still counted as committed, and their child-days use their centre's mean requested days per week.</p>
</div>

<div class="card">
  <h2 style="margin-top:0;"><%= mLong(am.month) %> in full <span class="muted" style="font-weight:400;font-size:13px;">· the same working, centre by centre</span></h2>
  <div style="overflow-x:auto;"><table>
    <thead>
      <tr>
        <th>Centre</th><th class="num">Places</th><th class="num">Available</th><th class="num">Run rate</th>
        <th class="num">Leavers</th><th class="num">Leaver days</th><th class="num">Firm starters</th><th class="num">Firm days</th>
        <th class="num">All-pipeline days</th><th class="num">Projected</th><th class="num">Target</th><th class="num">% filled</th><th class="num" title="Targeted child-days − projected, at that centre's own target">Gap to target</th>
      </tr>
    </thead>
    <tbody>
      <% coe.centres.forEach(function(c){ var x = c.months[ai]; %>
        <tr>
          <td><a class="row-link" href="/centre/<%= c.owna_id %>"><%= shortName(c.name) %></a></td>
          <td class="num"><%= c.places %></td>
          <td class="num"><%= fmt(x.available_days) %></td>
          <td class="num"><%= fmt(x.run_rate_days) %></td>
          <td class="num"><%= x.leavers_to_date %></td>
          <td class="num bad-text"><%= sgn(x.leaver_days) %></td>
          <td class="num"><%= x.firm_children %><% if (x.days_unknown) { %><span class="muted"> (<%= x.days_unknown %> est.)</span><% } %></td>
          <td class="num good-text">+<%= fmt(x.firm_days) %></td>
          <td class="num muted"><%= fmt(x.all_days) %></td>
          <td class="num"><strong><%= fmt(x.projected_days) %></strong></td>
          <td class="num"><%= fmt(x.target_days) %><br><span class="muted" style="font-size:11.5px;"><%= pctStr(c.target_pct) %><%= c.target_source === 'centre' ? '' : ' default' %></span></td>
          <td class="num coe-pct <%= tone(x.pct, c.target_pct) %>"><%= x.pct %>%</td>
          <td class="num"><%= x.gap_days > 0 ? fmt(x.gap_days) : '—' %></td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr class="total-row">
        <td>All operating centres</td>
        <td class="num"><%= coe.group.places %></td>
        <td class="num"><%= fmt(ga.available_days) %></td>
        <td class="num"><%= fmt(ga.run_rate_days) %></td>
        <td class="num"><%= ga.leavers_to_date %></td>
        <td class="num"><%= sgn(ga.leaver_days) %></td>
        <td class="num"><%= ga.firm_children %><% if (ga.days_unknown) { %><span class="muted"> (<%= ga.days_unknown %> est.)</span><% } %></td>
        <td class="num">+<%= fmt(ga.firm_days) %></td>
        <td class="num"><%= fmt(ga.all_days) %></td>
        <td class="num"><%= fmt(ga.projected_days) %></td>
        <td class="num"><%= fmt(ga.target_days) %><br><span class="muted" style="font-size:11.5px;"><%= pctStr(ga.target_pct) %></span></td>
        <td class="num coe-pct <%= tone(ga.pct, ga.target_pct) %>"><%= ga.pct %>%</td>
        <td class="num"><%= ga.gap_days > 0 ? fmt(ga.gap_days) : '—' %></td>
      </tr>
    </tfoot>
  </table></div>
  <p class="footnote" style="margin-bottom:0;"><strong>Target</strong> is that centre's own targeted child-days — approved places × operating days × its stored target — so the gap beside it is the gap to the number that centre is actually managed to. The group row targets <%= fmt(ga.target_days) %> child-days, the four centre targets weighted by approved places (<%= pctStr(GTGT) %>); the centre-by-centre shortfall in the table above is <%= fmt(ga.shortfall_days) %>, larger because a centre over its target cannot fill a seat at one under it.</p>
</div>

<% if (coe.opening.length) { %>
<div class="card pipeline-card">
  <h2 style="margin-top:0;">Opening centres, first fill <span class="muted" style="font-weight:400;font-size:13px;">· <%= coe.opening.map(function(c){ return shortName(c.name) + ' ' + openMonth(c); }).join(' · ') %></span></h2>
  <p class="sub" style="margin-bottom:14px;">No families to continue, only new ones — so there is no run rate. Licensed places are not recorded for these centres yet, so <strong>% once licensed places are confirmed</strong>; until then the honest figure is child-days committed.</p>
  <div style="overflow-x:auto;"><table>
    <thead>
      <tr><th>Centre</th><th>Opens</th><th></th><% coe.months.forEach(function(x){ %><th class="num"><%= mShort(x.month) %><br><span style="font-weight:400;text-transform:none;letter-spacing:0;"><%= x.operating_days %> days</span></th><% }); %></tr>
    </thead>
    <tbody>
      <% coe.opening.forEach(function(c){ %>
        <tr>
          <td rowspan="2"><a class="row-link" href="/centre/<%= c.owna_id %>"><%= shortName(c.name) %></a></td>
          <td rowspan="2"><%= openMonth(c) %></td>
          <td>Firm child-days<br><span class="muted" style="font-size:11.5px;">Offer Accepted / Pre-Offered</span></td>
          <% c.months.forEach(function(x){ %><td class="num"><strong><%= fmt(x.firm_days) %></strong><br><span class="muted" style="font-size:11.5px;"><%= x.firm_children %> child<%= x.firm_children === 1 ? '' : 'ren' %></span></td><% }); %>
        </tr>
        <tr>
          <td class="muted">All-pipeline child-days<br><span style="font-size:11.5px;">any status, including waitlist</span></td>
          <% c.months.forEach(function(x){ %><td class="num muted"><%= fmt(x.all_days) %><br><span style="font-size:11.5px;"><%= x.all_children %> child<%= x.all_children === 1 ? '' : 'ren' %></span></td><% }); %>
        </tr>
      <% }); %>
    </tbody>
  </table></div>
  <div class="two-col" style="margin-top:20px;">
    <% coe.opening.forEach(function(c){ var mx = Math.max.apply(null, Object.keys(c.mix).map(function(k){ return c.mix[k]; }).concat([1])); %>
      <div>
        <h3 style="margin:0 0 10px;font-size:14px;color:var(--brand-ink);"><%= shortName(c.name) %> · requested weekdays <span class="muted" style="font-weight:400;">· <%= c.mix_families %> families with requested days recorded</span></h3>
        <div class="coe-mix">
          <% ['mo','tu','we','th','fr'].forEach(function(d){ %><div style="height:<%= Math.round(c.mix[d] / mx * 100) %>%;" title="<%= c.mix[d] %> families asked for this day"></div><% }); %>
        </div>
        <div class="coe-mix-x">
          <% [['mo','Mon'],['tu','Tue'],['we','Wed'],['th','Thu'],['fr','Fri']].forEach(function(p){ %><span><%= p[1] %><br><strong><%= c.mix[p[0]] %></strong></span><% }); %>
        </div>
      </div>
    <% }); %>
  </div>
  <p class="footnote" style="margin-bottom:0;">Weekday mix counts how many pipeline families asked for each day, from every expected start recorded on or after <%= dLong(coe.pipeline_from) %> (no month cut-off), so one family appears in as many columns as the days they asked for. A family whose requested days are not recorded is counted in the child-days above, at the centre's mean requested days per week, but cannot appear in the mix. Child-days before a centre's opening month are start dates recorded ahead of the opening in LineLeader, not an error — they are shown as recorded. Park Rd (2028) is excluded: it opens well beyond this window.</p>
</div>
<% } %>

<%# The thirteen-paragraph "How every number on this page is calculated" card moved to /coe/method
    on 16 Sept 2026. It is worth writing down once; it was not worth a screen of everyone's
    attention on every visit. %>
<p class="footnote">
  <a class="row-link" href="/coe/method">How these numbers are calculated &rarr;</a>
  <% if (locals.lastRun && lastRun.finished_at) { %> · Data as at last sync <%= sydneyStamp(lastRun.finished_at) %>.<% } %>
</p>

<%- include('partials/footer') %>
