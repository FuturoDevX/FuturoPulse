        <div class="coe-mix">
          <% ['mo','tu','we','th','fr'].forEach(function(d){ %><div style="height:<%= Math.round(c.mix[d] / mx * 100) %>%;" title="<%= c.mix[d] %> families asked for this day"></div><% }); %>
        </div>
        <div class="coe-mix-x">
          <% [['mo','Mon'],['tu','Tue'],['we','Wed'],['th','Thu'],['fr','Fri']].forEach(function(p){ %><span><%= p[1] %><br><strong><%= c.mix[p[0]] %></strong></span><% }); %>
