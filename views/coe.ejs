      <tr>
        <th>Centre</th><th class="num">Places</th><th class="num">Available</th><th class="num">Run rate</th>
        <th class="num">Leavers</th><th class="num">Leaver days</th><th class="num">Firm starters</th><th class="num">Firm days</th>
        <th class="num">All-pipeline days</th><th class="num">Projected</th><th class="num">% filled</th><th class="num">Gap to <%= TGT %>%</th>
      </tr>
