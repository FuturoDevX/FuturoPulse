<%- include('partials/header', { title: 'Action Plans' }) %>
<%
  const shortName = (n) => (n||'').replace('Futuro Childcare & Education - ','').replace(/Futuro Childcare (and|&) Education\s*-?\s*/i,'').replace('Futuro ','').trim();
  const mLabel = (m) => { if(!m) return ''; const [y,mo]=m.split('-'); return new Date(y,mo-1,1).toLocaleDateString('en-AU',{month:'long',year:'numeric'}); };
  const dot = (r) => '<span class="rag rag-'+(['green','amber','red'].includes(r) ? r : 'none')+'"></span>';
  const areas = (data && data.plan) ? data.plan.areas : {};
  const auto = data ? data.auto : {};
%>
<div class="page-head">
  <div><h1>Action Plan</h1><p class="sub"><%= centre ? shortName(centre.name) : '' %> · <%= mLabel(month) %> <% if(data&&data.plan&&data.plan.overall){ %><%- dot(data.plan.overall) %> <%= data.plan.overall %><% } %></p></div>
  <div class="head-actions" style="display:flex;gap:8px;align-items:center;">
    <% if (!locals.scopedOwnaId) { %>
    <form method="GET" style="display:inline;"><select name="owna" onchange="this.form.submit()"><% centres.forEach(function(c){ %><option value="<%= c.owna_id %>" <%= c.owna_id===owna?'selected':'' %>><%= shortName(c.name) %></option><% }); %></select><input type="hidden" name="month" value="<%= month %>"></form>
    <% } %>
    <form method="GET" style="display:inline;"><input type="hidden" name="owna" value="<%= owna %>"><select name="month" onchange="this.form.submit()"><% months.forEach(function(mm){ %><option value="<%= mm %>" <%= mm===month?'selected':'' %>><%= mLabel(mm) %></option><% }); %></select></form>
    <% if (canEdit) { %><a class="btn" style="text-decoration:none;" href="/action-plans/edit?owna=<%= owna %>&month=<%= month %>">Edit plan</a><% } %>
  </div>
</div>

<% if (data && data.plan && data.plan.context) { %><div class="card"><h2 style="margin-top:0;">Centre context</h2><p style="white-space:pre-wrap;margin:0;"><%= data.plan.context %></p></div><% } %>

<div class="card">
  <h2 style="margin-top:0;">Status assessment</h2>
  <table>
    <thead><tr><th>Area</th><th style="width:90px;">Rating</th><th>Reasoning</th></tr></thead>
    <tbody>
      <% (data?data.areasDef:[]).forEach(function(a){ var av = areas[a.key]||{}; var rating = av.rating || (auto[a.key]&&auto[a.key].rating) || null; var reason = av.reason || (auto[a.key]&&auto[a.key].reason) || ''; %>
        <tr>
          <td><strong style="font-size:12px;color:var(--muted);"><%= a.group %></strong><br><%= a.label %></td>
          <td><%- dot(rating) %> <span style="text-transform:capitalize;font-size:13px;"><%= rating || '—' %></span><% if(!av.rating && auto[a.key]){ %><br><span class="muted" style="font-size:10px;">auto</span><% } %></td>
          <td style="white-space:normal;"><%= reason || '—' %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  <p class="footnote">Ratings are auto-suggested from live data (occupancy, wages, compliance, turnover, eNPS) unless a manual rating was set.</p>
</div>

<% cats.forEach(function(cat){ var items=(data?data.items:[]).filter(i=>i.category===cat[0] && (i.focus_area||i.actions)); if(!items.length) return; %>
  <div class="card">
    <h2 style="margin-top:0;"><%= cat[1] %></h2>
    <div style="overflow-x:auto;"><table>
      <thead><tr><th>Focus area</th><th>Actions</th><th>Owner</th><th>Status</th></tr></thead>
      <tbody><% items.forEach(function(i){ %><tr><td><%= i.focus_area %></td><td style="white-space:normal;"><%= i.actions %></td><td><%= i.owner||'—' %></td><td><span class="reason-tag"><%= i.status||'—' %></span></td></tr><% if(i.start_date||i.due_date||i.progress||i.outcome||i.priority||i.job_reference){ %><tr><td colspan="4" style="white-space:normal;"><div class="user-form"><% [['Start / logged',i.start_date],['Due',i.due_date],['Progress',i.progress],['Intended outcome',i.outcome],['Priority',i.priority],['Job reference',i.job_reference]].forEach(function(f){if(f[1]){ %><div><strong><%= f[0] %>:</strong> <%= f[1] %></div><% }}); %></div></td></tr><% } %><% }); %></tbody>
    </table></div>
  </div>
<% }); %>
<%- include('partials/footer') %>
