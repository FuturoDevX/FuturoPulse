<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %>Futuro Pulse</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
<% const user = locals.user; %>
<% if (user) { %>
<div class="app-shell">
  <aside class="sidebar">
    <div class="brand">Futuro Pulse<span>Operations</span></div>
    <nav class="side-nav">
      <a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Overview</a>
      <a href="/pc" class="<%= currentPath === '/pc' ? 'active' : '' %>">People &amp; Culture</a>
      <a href="/qc" class="<%= currentPath === '/qc' ? 'active' : '' %>">Quality &amp; Compliance</a>
      <a href="/action-plans" class="<%= currentPath.indexOf('/action-plans')===0 ? 'active' : '' %>">Action Plans</a>
      <a href="/safety" class="<%= currentPath === '/safety' ? 'active' : '' %>">Safety &amp; Incidents</a>
      <a href="/rostering" class="<%= currentPath === '/rostering' ? 'active' : '' %>">Rostering</a>
      <% if (!locals.scopedOwnaId) { %>
        <a href="/pipeline" class="<%= currentPath === '/pipeline' ? 'active' : '' %>">Enrolment Pipeline</a>
        <a href="/exits" class="<%= currentPath === '/exits' ? 'active' : '' %>">Exit Report</a>
        <a href="/projection" class="<%= currentPath === '/projection' ? 'active' : '' %>">Projection</a>
        <a href="/wages" class="<%= currentPath === '/wages' ? 'active' : '' %>">Wages &amp; Margin</a>
      <% } %>
      <% var navShort = function(n){ return (n||'').replace(/Futuro Childcare (and|&) Education\s*-?\s*/i,'').replace('Futuro ','').trim(); }; %>
      <div class="side-nav-divider">Centres</div>
      <% (locals.navCentres || []).filter(function(c){ return !c.opening; }).forEach(function(c){ %>
        <a href="/centre/<%= c.owna_id %>" class="<%= currentPath === '/centre/' + c.owna_id ? 'active' : '' %>"><%= navShort(c.name) %></a>
      <% }); %>
      <% var openingCentres = (locals.navCentres || []).filter(function(c){ return c.opening; }); %>
      <% if (openingCentres.length) { %>
        <div class="side-nav-divider">Opening soon</div>
        <% openingCentres.forEach(function(c){ %>
          <a href="/centre/<%= c.owna_id %>" class="<%= currentPath === '/centre/' + c.owna_id ? 'active' : '' %>"><%= navShort(c.name) %> <span class="nav-soon">soon</span></a>
        <% }); %>
      <% } %>
      <% if (user.role === 'admin') { %>
        <div class="side-nav-divider">Admin</div>
        <a href="/admin/users" class="<%= currentPath === '/admin/users' ? 'active' : '' %>">Users &amp; access</a>
        <a href="/admin/pc" class="<%= currentPath === '/admin/pc' ? 'active' : '' %>">P&amp;C Data</a>
        <a href="/admin/qc" class="<%= currentPath === '/admin/qc' ? 'active' : '' %>">Q&amp;C Data</a>
      <% } %>
    </nav>
    <div class="side-nav-footer">
      <span class="badge role-<%= user.role %>"><%= user.role.replace('_',' ') %></span>
      <form method="POST" action="/logout" class="inline">
        <button type="submit" class="secondary">Log out</button>
      </form>
    </div>
  </aside>
  <main>
    <% if (locals.msg) { %><div class="flash"><%= msg %></div><% } %>
<% } else { %>
  <main class="no-sidebar">
<% } %>
