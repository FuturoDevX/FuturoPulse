<%
  // Expects `lc = { labels:[...], series:[{name, points:[num|null], color?, dashFrom?}], height?, suf?, money? }`
  // dashFrom (per series or lc-wide via lc.dashFrom): index from which the line is drawn dashed ("projected / in progress").
  const _h = lc.height || 180;
  const _W = 1000, _yaxisW = 46;
  let _all = []; lc.series.forEach(s => s.points.forEach(v => { if(v!=null) _all.push(v); }));
  const _hasData = _all.length > 0;
  if (lc.target != null && _hasData) _all.push(lc.target); // keep the target line in view
  const _dmin = _hasData ? Math.min(..._all) : 0, _dmax = _hasData ? Math.max(..._all) : 1;
  // "nice" y bounds + ticks
  function _niceStep(range) { const raw = (range || 1) / 3; const mag = Math.pow(10, Math.floor(Math.log10(raw))); const n = raw / mag; const s = n < 1.5 ? 1 : n < 3 ? 2 : n < 7 ? 5 : 10; return s * mag; }
  const _step = _niceStep(_dmax - _dmin);
  const _lo = Math.floor(_dmin / _step) * _step, _hi = Math.max(_lo + _step, Math.ceil(_dmax / _step) * _step);
  const _ticks = []; for (let v = _lo; v <= _hi + 1e-9; v += _step) _ticks.push(Math.round(v * 100) / 100);
  const _rng = (_hi - _lo) || 1, _n = lc.labels.length;
  const _x = (i) => _n <= 1 ? _W / 2 : (i / (_n - 1)) * _W;
  const _y = (v) => _h - ((v - _lo) / _rng) * (_h - 6) - 3;
  const _COLORS = ['#1f3864','#6d2e46','#2e7d32','#b8860b','#2b7a9b','#9a5b00'];
  const _step2 = Math.max(1, Math.ceil(_n / 9));
  const _fmtAxis = (v) => {
    if (!lc.money) return (Math.round(v*10)/10) + (lc.suf||'');
    const a = Math.abs(v);
    if (a >= 1000000) return '$' + (Math.round(v/100000)/10) + 'M';
    if (a >= 1000) return '$' + Math.round(v/1000) + 'k';
    return '$' + Math.round(v);
  };
  const _fmtVal = (v) => v==null ? '' : (lc.money ? '$' + Math.round(v).toLocaleString('en-AU') : (Math.round(v*10)/10) + (lc.suf||''));
  // segment builder: array of "x,y" strings. Normally split on nulls (a gap = missing data);
  // with lc.connect, draw one continuous line through the real entries (for sparse cadences
  // like quarterly eNPS, where most months are intentionally empty).
  const _segs = (pts) => { const out=[]; let cur=[]; pts.forEach((v,i)=>{ if(v==null){ if(!lc.connect && cur.length){out.push(cur);cur=[];} } else cur.push(_x(i).toFixed(1)+','+_y(v).toFixed(1)); }); if(cur.length) out.push(cur); return out; };
%>
<% if (!_hasData) { %>
  <p class="muted" style="margin:12px 0 2px;font-size:13px;">No data for this selection yet.</p>
<% } else { %>
<div class="lc" style="position:relative;height:<%= _h %>px;">
  <div class="lc-yaxis" style="width:<%= _yaxisW %>px;">
    <% _ticks.forEach(function(t){ %><span style="top:<%= _y(t).toFixed(1) %>px;"><%= _fmtAxis(t) %></span><% }); %>
  </div>
  <div style="margin-left:<%= _yaxisW %>px;height:<%= _h %>px;">
    <svg viewBox="0 0 <%= _W %> <%= _h %>" preserveAspectRatio="none" style="width:100%;height:<%= _h %>px;display:block;">
      <% _ticks.forEach(function(t){ %><line x1="0" y1="<%= _y(t).toFixed(1) %>" x2="<%= _W %>" y2="<%= _y(t).toFixed(1) %>" stroke="var(--line)" stroke-width="1" vector-effect="non-scaling-stroke"/><% }); %>
      <% if (lc.target != null) { %><line x1="0" y1="<%= _y(lc.target).toFixed(1) %>" x2="<%= _W %>" y2="<%= _y(lc.target).toFixed(1) %>" stroke="var(--warn)" stroke-width="1.2" stroke-dasharray="4 3" opacity="0.75" vector-effect="non-scaling-stroke"/><% } %>
      <% lc.series.forEach(function(s, si){ var col = s.color || _COLORS[si % _COLORS.length];
           var df = (s.dashFrom != null) ? s.dashFrom : lc.dashFrom;
           var hist = df==null ? s.points : s.points.map(function(v,i){ return i<=df ? v : null; });
           var proj = df==null ? s.points.map(function(){return null;}) : s.points.map(function(v,i){ return i>=df ? v : null; });
      %>
        <% _segs(hist).forEach(function(sg){ %><polyline points="<%= sg.join(' ') %>" fill="none" stroke="<%= col %>" stroke-width="2.2" vector-effect="non-scaling-stroke" stroke-linejoin="round"/><% }); %>
        <% _segs(proj).forEach(function(sg){ %><polyline points="<%= sg.join(' ') %>" fill="none" stroke="<%= col %>" stroke-width="2.2" stroke-dasharray="5 4" vector-effect="non-scaling-stroke" stroke-linejoin="round"/><% }); %>
        <% s.points.forEach(function(v,i){ if(v!=null){ %><circle cx="<%= _x(i).toFixed(1) %>" cy="<%= _y(v).toFixed(1) %>" r="3" fill="<%= col %>"><title><%= s.name %> · <%= lc.labels[i] %>: <%= _fmtVal(v) %></title></circle><% } }); %>
      <% }); %>
    </svg>
    <div class="lc-xaxis"><% lc.labels.forEach(function(l,i){ %><span><%= (i % _step2 === 0 || i === _n-1) ? l : '' %></span><% }); %></div>
  </div>
</div>
<% if (lc.series.length > 1 || lc.dashFrom != null || lc.target != null || lc.series.some(function(s){return s.dashFrom!=null;})) { %>
<div class="lc-legend">
  <% lc.series.forEach(function(s,si){ var col = s.color || _COLORS[si % _COLORS.length]; %><span class="lc-key"><i style="background:<%= col %>"></i><%= s.name %></span><% }); %>
  <% if (lc.target != null) { %><span class="lc-key"><i class="dashed" style="border-top-color:var(--warn);"></i>target</span><% } %>
  <% if (lc.dashFrom != null || lc.series.some(function(s){return s.dashFrom!=null;})) { %><span class="lc-key"><i class="dashed"></i>projected / in progress</span><% } %>
</div>
<% } %>
<% } %>
