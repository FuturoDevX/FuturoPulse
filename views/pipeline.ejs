<%- include('partials/header', { title: 'Enrolment Pipeline' }) %>
<%
  const shortName = (n) => (n||'').replace(/Futuro Childcare (and|&) Education\s*-?\s*/i,'').replace('Futuro ','').trim();
  const p = pipeline;
  const t = p.totals || {};
  // One source for every current-state figure on this page: the per-child pipeline behind the funnel.
  // `p.totals` is a separate daily count-by-status snapshot kept for the trend below, and the two do
  // not agree — it is a different call to LineLeader, taken at a different moment.
  const fg = (locals.funnelAll || funnel).group, stageCount = (id) => (fg.stages.find((x) => x.id === id) || {}).count || 0;
  const fTot = {
    waitlist: fg.waitlist.count,
    offers: stageCount(5),
    active: stageCount(1) + stageCount(2) + stageCount(11) + stageCount(3),
  };
  // Sparkline: return an SVG polyline points string, scaled to each stage's own range.
  const spark = (pts, w, h) => {
    if (!pts || !pts.length) return '';
    const max = Math.max(...pts), min = Math.min(...pts), rng = (max - min) || 1, n = pts.length;
    const x = (i) => n === 1 ? w / 2 : (i / (n - 1)) * w;
    const y = (v) => h - ((v - min) / rng) * (h - 2) - 1;
    return pts.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
  };
%>

<div class="page-head">
  <div>
    <h1>Enrolment Pipeline</h1>
    <p class="sub">Leads &amp; waitlist from LineLeader<%= p.date ? ' · as at ' + p.date : '' %></p>
  </div>
</div>

<% if (!p.rows.length) { %>
  <div class="card"><p class="muted">No LineLeader data yet. Run a refresh (need LineLeader credentials in .env).</p></div>
<% } %>

<% if (p.rows.length) { %>
<div class="grid kpis">
  <%# These read the same per-child pipeline the funnel table below is built from. They used to read a
      separate daily count-by-status snapshot, which is a different query against LineLeader and gave
      different answers — the tile said 440 on the waitlist while the table underneath said 456. %>
  <div class="card stat"><div class="n"><%= fTot.waitlist.toLocaleString('en-AU') %></div><div class="l">On waitlist</div></div>
  <div class="card stat"><div class="n"><%= fTot.offers.toLocaleString('en-AU') %></div><div class="l">Offers accepted</div></div>
  <div class="card stat"><div class="n"><%= fTot.active.toLocaleString('en-AU') %></div><div class="l">Active leads</div></div>
<%# Removed 15 Sept 2026: "Expected starts (120d)", "Withdrawn (120d)" and "Indicative net". The query
    feeding them had no date filter, so they counted every enrolment record ever written — out to 2029 —
    while the label promised 120 days. The group read 1,554 expected starts and +1,520 net against 501
    licensed places and 764 children enrolled. Expected starts with a real window are on the Continuation
    of Enrolment page, which counts them per month against places. %>
</div>
<% } %>

<%
  const mLong = (mo) => { const q = mo.split('-'); return new Date(q[0], q[1]-1, 1).toLocaleDateString('en-AU', {month:'long', year:'numeric'}); };
  const mShort = (mo) => { const q = mo.split('-'); return new Date(q[0], q[1]-1, 1).toLocaleDateString('en-AU', {month:'short', year:'2-digit'}); };
  const dLong = (d) => new Date(d + 'T00:00:00').toLocaleDateString('en-AU', {day:'numeric', month:'short', year:'numeric'});
  const canEditTargets = ['admin','ops_manager'].includes(user.role);
  const f = funnel; const isCohort = f.mode === 'cohort';
%>
<% if (progress.rows.length) { %>
<div class="card">
  <div class="pc-head">
    <h2 style="margin:0;">This month vs targets <span class="muted" style="font-weight:400;font-size:13px;">· <%= mLong(progress.month) %> · day <%= progress.day %> of <%= progress.days_in_month %></span></h2>
    <% if (canEditTargets) { %><a class="secondary-btn" style="text-decoration:none;padding:7px 12px;border-radius:6px;" href="/admin/pipeline-targets">Set targets</a><% } %>
  </div>
  <div style="overflow-x:auto;">
  <table>
    <thead><tr><th>Centre</th><th class="num">New leads so far</th><th class="num">Target</th><th class="num">Δ</th><th class="num">Tours held so far</th><th class="num">Target</th><th class="num">Δ</th></tr></thead>
    <tbody>
      <% progress.rows.forEach(function(r){ %>
        <tr>
          <td><%= shortName(r.name) %><% if (r.opening) { %> <span class="muted">(opening)</span><% } %></td>
          <td class="num"><%= r.leads %></td>
          <td class="num"><%= r.leads_target != null ? r.leads_target : '—' %></td>
          <td class="num"><% if (r.leads_rag) { %><span class="badge <%= r.leads_rag %>"><%= r.leads_delta >= 0 ? '+' : '' %><%= r.leads_delta %></span><% } else { %>—<% } %></td>
          <td class="num"><%= r.tours_held %><% if (r.tours_held !== r.tours_completed) { %> <span class="muted" title="Tours LineLeader marks complete">(<%= r.tours_completed %> marked complete)</span><% } %></td>
          <td class="num"><%= r.tours_target != null ? r.tours_target : '—' %></td>
          <td class="num"><% if (r.tours_rag) { %><span class="badge <%= r.tours_rag %>"><%= r.tours_delta >= 0 ? '+' : '' %><%= r.tours_delta %></span><% } else { %>—<% } %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
  <p class="footnote">
    Month to date. Δ = so far − monthly target: <span class="badge good">green</span> target already met, <span class="badge warn">amber</span> on pace with <%= Math.round(progress.elapsed*100) %>% of the month elapsed, <span class="badge bad">red</span> behind pace; “—” = no target set<% if (canEditTargets) { %> (use Set targets)<% } %>.
    Leads = families whose LineLeader wait-list date falls in <%= mLong(progress.month) %>. A tour counts as held when LineLeader marks it complete, or its scheduled date has passed and it was not cancelled — tours are rarely ticked complete in LineLeader, so the completed count is shown alongside; no-shows that were not cancelled are counted as held.
  </p>
</div>
<% } %>

<div class="card">
  <div class="pc-head">
    <h2 style="margin:0;">Funnel conversions by centre <span class="muted" style="font-weight:400;font-size:13px;">· <%= isCohort ? 'families who joined the wait list in ' + mLong(f.month) : 'all pipeline families' %></span></h2>
    <% if (funnelMonths.length) { %>
    <form method="GET"><% if (trendOwna) { %><input type="hidden" name="owna" value="<%= trendOwna %>"><% } %>
      <select name="month" onchange="this.form.submit()">
        <option value="" <%= !funnelMonth ? 'selected' : '' %>>All leads</option>
        <% funnelMonths.forEach(function(mo){ %><option value="<%= mo %>" <%= mo === funnelMonth ? 'selected' : '' %>>Joined <%= mShort(mo) %></option><% }); %>
      </select>
    </form>
    <% } %>
  </div>
  <h3 style="margin:14px 0 6px;font-size:14px;">Where <%= isCohort ? 'that month’s leads' : 'families' %> are now <span class="muted" style="font-weight:400;font-size:12px;">· snapshot of the LineLeader pipeline today · count and % of the centre’s <%= isCohort ? 'cohort' : 'pipeline' %></span></h3>
  <div style="overflow-x:auto;">
  <table>
    <thead><tr><th>Centre</th><% f.stages.forEach(function(s){ %><th class="num"><%= s[1] %></th><% }); %><th class="num">Waitlist</th><th class="num">Total</th></tr></thead>
    <tbody>
      <% f.rows.forEach(function(r){ %>
        <tr>
          <td><%= shortName(r.name) %><% if (r.opening) { %> <span class="muted">(opening)</span><% } %></td>
          <% r.stages.forEach(function(s){ %><td class="num"><%= s.count %><% if (r.total) { %> <span class="muted"><%= s.share %>%</span><% } %></td><% }); %>
          <td class="num <%= r.waitlist.count > 0 ? 'hot' : '' %>"><%= r.waitlist.count %><% if (r.total) { %> <span class="muted"><%= r.waitlist.share %>%</span><% } %></td>
          <td class="num"><%= r.total %></td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr class="total-row">
        <td>All centres</td>
        <% f.group.stages.forEach(function(s){ %><td class="num"><%= s.count %><% if (f.group.total) { %> <span class="muted"><%= s.share %>%</span><% } %></td><% }); %>
        <td class="num"><%= f.group.waitlist.count %><% if (f.group.total) { %> <span class="muted"><%= f.group.waitlist.share %>%</span><% } %></td>
        <td class="num"><%= f.group.total %></td>
      </tr>
    </tfoot>
  </table>
  </div>

  <h3 style="margin:18px 0 6px;font-size:14px;"><%= isCohort ? 'How far ' + mLong(f.month) + '’s leads have got' : 'Conversion over the last 12 months' %> <span class="muted" style="font-weight:400;font-size:12px;">· <%= isCohort ? 'the cohort’s journey so far' : 'activity ' + dLong(f.from) + ' → ' + dLong(f.to) %> · each step also as % of leads</span></h3>
  <div style="overflow-x:auto;">
  <table>
    <thead><tr><th>Centre</th><th class="num">Leads joined</th><th class="num">→ Tours held</th><th class="num">→ Offers accepted</th><th class="num">→ Started</th></tr></thead>
    <tbody>
      <% f.rows.concat([Object.assign({ name: 'All centres', total_row: true }, f.group)]).forEach(function(r){ var s = r.strip; %>
        <tr class="<%= r.total_row ? 'total-row' : '' %>">
          <td><%= r.total_row ? r.name : shortName(r.name) %><% if (r.opening) { %> <span class="muted">(opening)</span><% } %></td>
          <td class="num"><%= s.leads %><% if (!isCohort && s.started) { %> <span class="muted" title="joined in the window + families who started (no longer in the pipeline)"><%= s.leads_joined %> + <%= s.started %></span><% } %></td>
          <td class="num"><%= s.tours_held %> <span class="muted"><%= s.leads ? s.tour_pct + '%' : '' %><% if (s.tours_held !== s.tours_completed) { %> · <%= s.tours_completed %> marked complete<% } %></span></td>
          <td class="num"><%= s.offers %> <span class="muted"><%= s.leads ? s.offer_pct + '%' : '' %></span></td>
          <td class="num"><% if (s.started == null) { %>—<% } else { %><%= s.started %> <span class="muted"><%= s.leads ? s.start_pct + '%' : '' %></span><% } %></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
  </div>
  <p class="footnote">
    <strong>Stage counts are a snapshot</strong> of who is in the LineLeader pipeline right now (New Family → Engaged → Tour Scheduled → Tour Completed → Pre-Offered → Offer Accepted, with Waitlist alongside); <strong>the conversion strip is activity</strong><%= isCohort ? ' for that month’s cohort' : ' over the 12 months to ' + dLong(f.to) %>.
    <% if (isCohort) { %>Cohort = families whose wait-list date falls in <%= mLong(f.month) %>; tours are those the cohort’s families held on or after the day they joined (an earlier tour belongs to an earlier enquiry). Families who have started leave the LineLeader pipeline and their wait-list date is not kept, so “Started” cannot be shown for a cohort (—) and a cohort can only shrink as it converts.<% } else { %>Leads = families who joined the wait list in the window plus families who started in it (they have left the pipeline, so starts are a floor for leads). LineLeader does not record when an offer was accepted, so “Offers accepted” = every family currently at Offer Accepted plus those who started. “Started” = LineLeader <em>Enrolled (Started)</em> records with a start date in the window — families are handed to OWNA at enrolment, so this understates real starts.<% } %>
    A tour counts as held when marked complete in LineLeader or when its date has passed without cancellation (completed-only counts shown where they differ). Pre-opening centres are marked (opening) while they build a pipeline.
  </p>
</div>

<% if (p.rows.length) { %>
<% var jMax = Math.max(1, ...joins.map(function(j){return j.count;})); var jTotal = joins.reduce(function(s,j){return s+j.count;},0); var jPeak = joins.reduce(function(a,b){return b.count>a.count?b:a;}, joins[0]||{count:0}); %>
<div class="card">
  <div class="pc-head">
    <h2 style="margin:0;">New families joining over time <span class="muted" style="font-weight:400;font-size:13px;">· <%= trendOwna ? shortName((trendCentres.find(function(c){return c.owna_id===trendOwna;})||{}).name) : 'all centres' %> · by waitlist join date</span></h2>
    <% if (trendCentres.length) { %>
    <form method="GET"><% if (funnelMonth) { %><input type="hidden" name="month" value="<%= funnelMonth %>"><% } %><select name="owna" onchange="this.form.submit()">
      <option value="" <%= !trendOwna?'selected':'' %>>All centres</option>
      <% trendCentres.forEach(function(c){ %><option value="<%= c.owna_id %>" <%= c.owna_id===trendOwna?'selected':'' %>><%= shortName(c.name) %></option><% }); %>
    </select></form>
    <% } %>
  </div>
  <% if (!jTotal) { %>
    <p class="muted" style="margin:10px 0 0;">No waitlist join dates recorded for this selection.</p>
  <% } else {
       var mLbl = function(m){ var p=m.split('-'); return new Date(p[0],p[1]-1,1).toLocaleDateString('en-AU',{month:'short',year:'2-digit'}); };
  %>
    <div class="chart" style="height:200px;">
      <% joins.forEach(function(j){ var isPeak = j.month===jPeak.month && j.count>0; %>
        <div class="chart-col" title="<%= mLbl(j.month) %>: <%= j.count %> new famil<%= j.count===1?'y':'ies' %> joined the waitlist">
          <div class="chart-bar" style="height:<%= Math.round(j.count/jMax*100) %>%; background:<%= isPeak ? 'var(--plum)' : 'var(--brand)' %>;"></div>
          <div class="chart-x"><strong style="color:var(--brand-ink);"><%= j.count %></strong><br><%= mLbl(j.month) %></div>
        </div>
      <% }); %>
    </div>
    <p class="footnote">
      Each bar = new families that joined the waitlist that month (by their LineLeader wait-list date). Peak: <strong><%= jPeak.count %></strong> in <%= mLbl(jPeak.month) %> (highlighted). Use this to spot the effect of marketing pushes — a campaign should show as a bar spike in the following weeks. Switch centres with the selector. Based on the <%= jTotal.toLocaleString('en-AU') %> current pipeline families with a recorded join date.
    </p>
  <% } %>
</div>

<%# Removed 15 Sept 2026: a second "Funnel by centre · current snapshot" table. It listed the same
    seven stages as the funnel above but was built from the daily count-by-status snapshot rather than
    the per-child pipeline, so every number disagreed with the table a few centimetres above it —
    waitlist 440 against 456, offers accepted 178 against 189. One page, one answer. %>
<p class="footnote">
  Waitlist column highlighted. Live enrolled headcount is on the Overview.
  Centres like Oran Park, Park Rd and Cobbitty appear here (building a pipeline) before they show in the OWNA occupancy view.
</p>
<% } %>

<%- include('partials/footer') %>
