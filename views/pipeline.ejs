<%- include('partials/header', { title: 'Enrolment Pipeline' }) %>
<%
  const shortName = (n) => (n||'').replace(/Futuro Childcare (and|&) Education\s*-?\s*/i,'').replace('Futuro ','').trim();
  const p = pipeline;
  const t = p.totals || {};
  // Sparkline: return an SVG polyline points string, scaled to each stage's own range.
  const spark = (pts, w, h) => {
    if (!pts || !pts.length) return '';
    const max = Math.max(...pts), min = Math.min(...pts), rng = (max - min) || 1, n = pts.length;
    const x = (i) => n === 1 ? w / 2 : (i / (n - 1)) * w;
    const y = (v) => h - ((v - min) / rng) * (h - 2) - 1;
    return pts.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(' ');
  };
%>

<div class="page-head">
  <div>
    <h1>Enrolment Pipeline</h1>
    <p class="sub">Leads &amp; waitlist from LineLeader<%= p.date ? ' · as at ' + p.date : '' %></p>
  </div>
</div>

<% if (!p.rows.length) { %>
  <div class="card"><p class="muted">No LineLeader data yet. Run a refresh (need LineLeader credentials in .env).</p></div>
<% } else { %>

<div class="grid kpis">
  <div class="card stat"><div class="n"><%= (t[4]||0).toLocaleString('en-AU') %></div><div class="l">On waitlist</div></div>
  <div class="card stat"><div class="n"><%= (t[5]||0).toLocaleString('en-AU') %></div><div class="l">Offers accepted</div></div>
  <div class="card stat"><div class="n"><%= ((t[1]||0)+(t[2]||0)+(t[11]||0)+(t[3]||0)).toLocaleString('en-AU') %></div><div class="l">Active leads</div></div>
  <div class="card stat"><div class="n"><%= (t.started||0).toLocaleString('en-AU') %></div><div class="l">Expected starts (120d)</div></div>
  <div class="card stat"><div class="n"><%= (t.withdrawn||0).toLocaleString('en-AU') %></div><div class="l">Withdrawn (120d)</div></div>
  <div class="card stat"><div class="n <%= (t.net||0) >= 0 ? 'good-text' : 'bad-text' %>"><%= (t.net||0) >= 0 ? '+' : '' %><%= (t.net||0).toLocaleString('en-AU') %></div><div class="l">Indicative net</div></div>
</div>

<% var jMax = Math.max(1, ...joins.map(function(j){return j.count;})); var jTotal = joins.reduce(function(s,j){return s+j.count;},0); var jPeak = joins.reduce(function(a,b){return b.count>a.count?b:a;}, joins[0]||{count:0}); %>
<div class="card">
  <div class="pc-head">
    <h2 style="margin:0;">New families joining over time <span class="muted" style="font-weight:400;font-size:13px;">· <%= trendOwna ? shortName((trendCentres.find(function(c){return c.owna_id===trendOwna;})||{}).name) : 'all centres' %> · by waitlist join date</span></h2>
    <% if (trendCentres.length) { %>
    <form method="GET"><select name="owna" onchange="this.form.submit()">
      <option value="" <%= !trendOwna?'selected':'' %>>All centres</option>
      <% trendCentres.forEach(function(c){ %><option value="<%= c.owna_id %>" <%= c.owna_id===trendOwna?'selected':'' %>><%= shortName(c.name) %></option><% }); %>
    </select></form>
    <% } %>
  </div>
  <% if (!jTotal) { %>
    <p class="muted" style="margin:10px 0 0;">No waitlist join dates recorded for this selection.</p>
  <% } else {
       var mLbl = function(m){ var p=m.split('-'); return new Date(p[0],p[1]-1,1).toLocaleDateString('en-AU',{month:'short',year:'2-digit'}); };
  %>
    <div class="chart" style="height:200px;">
      <% joins.forEach(function(j){ var isPeak = j.month===jPeak.month && j.count>0; %>
        <div class="chart-col" title="<%= mLbl(j.month) %>: <%= j.count %> new famil<%= j.count===1?'y':'ies' %> joined the waitlist">
          <div class="chart-bar" style="height:<%= Math.round(j.count/jMax*100) %>%; background:<%= isPeak ? 'var(--berry)' : 'var(--navy)' %>;"></div>
          <div class="chart-x"><strong style="color:var(--navy);"><%= j.count %></strong><br><%= mLbl(j.month) %></div>
        </div>
      <% }); %>
    </div>
    <p class="footnote">
      Each bar = new families that joined the waitlist that month (by their LineLeader wait-list date). Peak: <strong><%= jPeak.count %></strong> in <%= mLbl(jPeak.month) %> (highlighted). Use this to spot the effect of marketing pushes — a campaign should show as a bar spike in the following weeks. Switch centres with the selector. Based on the <%= jTotal.toLocaleString('en-AU') %> current pipeline families with a recorded join date.
    </p>
  <% } %>
</div>

<div class="card">
  <h2 style="margin-top:0;">Funnel by centre <span class="muted" style="font-weight:400;font-size:13px;">· current snapshot</span></h2>
  <div style="overflow-x:auto;">
  <table>
    <thead>
      <tr>
        <th>Centre</th>
        <% p.funnel.forEach(function(f){ %><th class="num"><%= f[1].replace(' (Started)','') %></th><% }); %>
        <th class="num" title="Started minus withdrawn in the snapshot window">Net</th>
      </tr>
    </thead>
    <tbody>
      <% p.rows.forEach(function(r){ %>
        <tr>
          <td><%= shortName(r.name) %></td>
          <% p.funnel.forEach(function(f){ var v=r.counts[f[0]]||0; %>
            <td class="num <%= f[0]===4 && v>0 ? 'hot' : '' %>"><%= v %></td>
          <% }); %>
          <td class="num <%= r.net>=0 ? 'good-text':'bad-text' %>"><%= r.net>=0?'+':'' %><%= r.net %></td>
        </tr>
      <% }); %>
    </tbody>
    <tfoot>
      <tr class="total-row">
        <td>All centres</td>
        <% p.funnel.forEach(function(f){ %><td class="num"><%= t[f[0]]||0 %></td><% }); %>
        <td class="num <%= (t.net||0)>=0 ? 'good-text':'bad-text' %>"><%= (t.net||0)>=0?'+':'' %><%= t.net||0 %></td>
      </tr>
    </tfoot>
  </table>
  </div>
</div>

<p class="footnote">
  Waitlist column highlighted. “Expected starts” counts enrolment records with an expected-start date in the last 120 days (includes places not yet confirmed enrolled), so “Indicative net” is directional, not a hard headcount; “Withdrawn” is exact. Live enrolled headcount is on the Overview.
  Centres like Oran Park, Park Rd and Cobbitty appear here (building a pipeline) before they show in the OWNA occupancy view.
</p>
<% } %>

<%- include('partials/footer') %>
