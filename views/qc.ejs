<%- include('partials/header', { title: 'Quality & Compliance' }) %>
<%
  const shortName = (n) => (n||'').replace('Futuro Childcare & Education - ','').replace(/Futuro Childcare (and|&) Education\s*-?\s*/i,'').replace('Futuro ','').trim();
  const pctClass = (p) => p==null ? '' : (p>=90 ? 'good' : p>=75 ? 'warn' : 'bad');
  const prPill = (p) => { const c = /high/i.test(p)?'bad':/med/i.test(p)?'warn':'muted'; return '<span class="reason-tag '+(c==='bad'?'bad':'')+'" style="'+(c==='warn'?'background:#fdf3d9;color:#8a6d0b;':'')+'">'+(p||'—')+'</span>'; };
  const isDone = (c) => /^y/i.test((c||'').trim());
%>
<div class="page-head"><div>
  <h1>Quality &amp; Compliance</h1>
  <p class="sub">From the bi-annual compliance audit (NQF Quality Areas QA1–QA7)</p>
</div><% if (user.role==='admin') { %><a class="secondary-btn" style="text-decoration:none;padding:7px 12px;border-radius:6px;align-self:center;" href="/admin/qc">Upload audit</a><% } %></div>

<% if (!summary.length) { %>
  <div class="card"><p class="muted">No audit uploaded yet. <% if (user.role==='admin'){ %>Go to <a href="/admin/qc">Upload audit</a>.<% } %></p></div>
<% } %>

<% summary.forEach(function(c){ %>
  <div class="card">
    <div class="pc-head">
      <h2 style="margin:0;"><%= shortName(c.centre_name) %> <span class="badge <%= pctClass(c.overall_pct) %>"><%= c.overall_pct %>% overall</span></h2>
      <span class="muted" style="font-size:13px;">Audited <%= c.audit_date || '—' %> · <%= c.auditor || '' %> <%= c.term ? '· '+c.term : '' %></span>
    </div>
    <div class="qa-grid">
      <% (c.qa||[]).forEach(function(q){ %>
        <div class="qa-cell">
          <div class="qa-code"><%= q.code %></div>
          <div class="qa-bar-wrap"><div class="qa-bar <%= pctClass(q.pct) %>" style="width:<%= Math.min(q.pct||0,100) %>%;"></div></div>
          <div class="qa-pct <%= pctClass(q.pct) %>-text"><%= q.pct %>%</div>
          <div class="qa-name muted"><%= q.name %></div>
        </div>
      <% }); %>
    </div>
    <% var open = (c.actions||[]).filter(a=>!isDone(a.completed)); %>
    <h3 class="stage-h" style="margin-top:18px;">Open action items <span class="badge bad"><%= open.length %></span> <span class="muted" style="font-weight:400;">of <%= (c.actions||[]).length %></span></h3>
    <div style="overflow-x:auto;">
    <table>
      <thead><tr><th>QA</th><th>Issue</th><th>Action required</th><th>Priority</th><th>Owner</th><th>Due</th></tr></thead>
      <tbody>
        <% (c.actions||[]).slice(0,60).forEach(function(a){ %>
          <tr class="<%= isDone(a.completed)?'future-row':'' %>">
            <td><%= a.quality_area %></td>
            <td><%= isDone(a.completed) ? '<s>'+(a.issue||'') : (a.issue||'') %><%= isDone(a.completed)?'</s>':'' %></td>
            <td style="max-width:320px;white-space:normal;"><%= (a.action||'').slice(0,180) %></td>
            <td><%- prPill(a.priority) %></td>
            <td><%= a.owner || '—' %></td>
            <td><%= a.due_date || (isDone(a.completed)?'done':'—') %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
    </div>
  </div>
<% }); %>
<%- include('partials/footer') %>
