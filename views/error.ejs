<%- include('partials/header', { title: 'Error' }) %>
<h1>Something went wrong</h1>
<div class="card">
  <p><%= message %></p>
  <%# `detail` is shown only to admin and ops: it is what the server actually observed, so a refusal
      can be diagnosed from the screen instead of from logs nobody on site can reach. Hostnames and
      status only — never a query, a body, or anything identifying a child, family or staff member. %>
  <% if (locals.detail && locals.user && ['admin','ops_manager'].includes(user.role)) { %>
    <p class="muted" style="font-size:13px;margin-top:14px;">What the server saw, for the developer:</p>
    <pre style="font-size:12.5px;background:var(--rule-soft,#eef1f6);padding:10px 12px;border-radius:6px;overflow-x:auto;margin:6px 0 0;"><%= detail %></pre>
  <% } %>
  <p><a class="row-link" href="/">← Back to overview</a></p>
</div>
<%- include('partials/footer') %>
