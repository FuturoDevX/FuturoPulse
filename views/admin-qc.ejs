<%- include('partials/header', { title: 'Q&C Upload' }) %>
<% const shortName = (n) => (n||'').replace('Futuro Childcare & Education - ','').replace(/Futuro Childcare (and|&) Education\s*-?\s*/i,'').replace('Futuro ','').trim(); %>
<div class="page-head"><div>
  <p class="crumb"><a href="/qc">← Quality &amp; Compliance</a></p>
  <h1>Upload compliance audit</h1>
  <p class="sub">Upload the audit .xlsx — the centre is matched from the Summary sheet automatically.</p>
</div></div>
<% if (msg) { %><div class="flash"><%= msg %></div><% } %>
<% if (err) { %><div class="flash bad"><%= err %></div><% } %>
<div class="card">
  <form method="POST" action="/admin/qc/upload" enctype="multipart/form-data" class="user-form">
    <div><label>Audit file (.xlsx)</label><input type="file" name="audit" accept=".xlsx" required></div>
    <div><label>Term / period (optional)</label><input type="text" name="term" placeholder="e.g. Term 2 2026"></div>
    <div style="align-self:end;"><button type="submit">Upload &amp; import</button></div>
  </form>
</div>
<div class="card">
  <h2 style="margin-top:0;">Uploaded audits</h2>
  <% if (!summary.length) { %><p class="muted">None yet.</p><% } else { %>
    <table><thead><tr><th>Centre</th><th class="num">Overall</th><th>Audit date</th><th class="num">Open actions</th><th>Uploaded</th></tr></thead>
    <tbody>
      <% summary.forEach(function(c){ %>
        <tr><td><%= shortName(c.centre_name) %></td><td class="num"><%= c.overall_pct %>%</td><td><%= c.audit_date || '—' %></td><td class="num"><%= c.open_actions %></td><td class="muted"><%= (c.uploaded_at||'').slice(0,16) %></td></tr>
      <% }); %>
    </tbody></table>
  <% } %>
</div>
<%- include('partials/footer') %>
