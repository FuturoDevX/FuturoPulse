<%- include('partials/header', { title: 'Sign in' }) %>
<div class="login-wrap">
  <div class="card login-card">
    <div class="brand-lg">Futuro Pulse<span>Operations</span></div>
    <% if (error) { %><div class="flash bad"><%= error %></div><% } %>
    <form method="POST" action="/login">
      <label>Email</label>
      <input type="email" name="email" autocomplete="username" required autofocus />
      <label>Password</label>
      <input type="password" name="password" autocomplete="current-password" required />
      <button type="submit" style="margin-top:18px;width:100%;">Sign in</button>
    </form>
    <p class="login-notice">Futuro Pulse shows operational information about our centres, including personal information about children, families and staff drawn from OWNA, LineLeader and Employment Hero. Use it only for your role, don’t share screenshots outside Futuro, and contact <%= privacyContact %> with any privacy question.</p>
  </div>
</div>
<%- include('partials/footer') %>
