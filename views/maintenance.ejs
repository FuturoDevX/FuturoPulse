<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Futuro Pulse — back shortly</title>
  <style>
    <%# Standalone page: it does not load /style.css, so it carries its own copy of the palette and
        names the two self-hosted faces itself. Static files are served before the maintenance
        middleware, so /fonts still answers while the dashboard is behind this page. %>
    @font-face { font-family:"Source Serif 4"; font-style:normal; font-weight:200 900; font-display:swap; src:url("/fonts/source-serif-4-latin.woff2") format("woff2"); }
    @font-face { font-family:"Inter"; font-style:normal; font-weight:400 700; font-display:swap; src:url("/fonts/inter-latin.woff2") format("woff2"); }
    :root { --brand:#1e3a2f; --brand-mid:#24463a; --brand-dark:#16291f; --ink:#26241f; --muted:#6e6960; --paper:#faf8f4; --surface:#fff; --rule:#eae3d8; }
    * { box-sizing: border-box; }
    body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px;
           background:var(--paper); color:var(--ink);
           font-family:"Inter","Segoe UI",system-ui,-apple-system,sans-serif; line-height:1.55; }
    .card { background:var(--surface); border:1px solid var(--rule); border-radius:12px; max-width:520px; width:100%;
            padding:0; overflow:hidden; box-shadow:0 1px 2px rgba(58,48,34,.04), 0 10px 28px rgba(58,48,34,.07); }
    .top { background:linear-gradient(180deg,var(--brand-mid) 0%, var(--brand) 52%, var(--brand-dark) 100%); color:#fff; padding:26px 30px; }
    .brand { font-family:"Source Serif 4",Georgia,serif; font-weight:600; font-size:21px; letter-spacing:-.015em; }
    .brand span { display:block; font-family:inherit; font-weight:500; font-size:10px; text-transform:uppercase; letter-spacing:.12em; opacity:.6; margin-top:4px; }
    .body { padding:26px 30px 28px; }
    h1 { font-family:"Source Serif 4",Georgia,serif; font-size:23px; font-weight:600; margin:0 0 10px; letter-spacing:-.02em; }
    p { margin:0 0 12px; color:var(--muted); font-size:15px; }
    p:last-child { margin-bottom:0; }
    .who { margin-top:18px; padding-top:16px; border-top:1px solid var(--rule); font-size:13.5px; }
    a { color:var(--brand); }
    @media (prefers-color-scheme: dark) {
      :root { --paper:#14170f; --surface:#1d2119; --ink:#eae6dd; --muted:#a3a094; --rule:#333a2e; --brand:#9cc0a8; }
      body { background:var(--paper); color:var(--ink); }
      .top { background:linear-gradient(180deg,#223a2e 0%, #1a2e24 52%, #13231b 100%); }
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="top"><div class="brand">Futuro Pulse<span>Operations</span></div></div>
    <div class="body">
      <h1>We're making some changes</h1>
      <p>Futuro Pulse is briefly offline while we tidy up a few pages. Nothing has been lost — your centres' data is safe in OWNA, Employment Hero and LineLeader, and the dashboard will pick it up again when it comes back.</p>
      <p>Please try again a little later.</p>
      <div class="who">
        <% if (locals.user) { %>
          You are signed in as <strong><%= user.name || user.email %></strong>, but this login cannot see the dashboard while it is offline.
          <a href="/logout">Sign out</a>
        <% } else { %>
          If you look after this dashboard, <a href="/login">sign in</a> to keep working.
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
