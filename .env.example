# Copy to .env and fill in before running

PORT=3003
SESSION_SECRET=change-me-to-a-long-random-string

# SQLite file path
DB_PATH=./data/owna.db

# Set to "production" on the live server — enables HTTPS-only session cookies and refuses
# to boot without SESSION_SECRET. Leave unset locally.
# NODE_ENV=production

# OWNA Childcare Portal API — https://api.owna.com.au/swagger/index.html
# Auth is a single API key sent as the "x-api-key" header. Treat it like a password.
OWNA_API_KEY=
OWNA_BASE_URL=https://api.owna.com.au

# How many days of history the nightly snapshot pulls/keeps (rolling window).
SNAPSHOT_WINDOW_DAYS=120
# How many days FORWARD to pull scheduled bookings + expected starts (forecast).
SNAPSHOT_FORWARD_DAYS=240

# Cron expression for the nightly snapshot (default 02:15 every day). Standard 5-field cron.
SNAPSHOT_CRON=15 2 * * *

# Default Admin account created on first seed. REQUIRED in production (the app refuses to boot
# without a real email and a 12+ character password). Change the password after first login.
ADMIN_EMAIL=
ADMIN_DEFAULT_PASSWORD=

# Shown in the privacy/collection notices (APP 5) — who to contact about personal information.
PRIVACY_CONTACT=the Privacy Officer

# One line at the foot of the sidebar — Futuro's own brand line. Left blank on purpose: nothing in
# this repo records one and the dashboard will not invent it. Fill it in and it appears; leave it
# blank and the slot is not rendered at all.
BRAND_TAGLINE=

# AI usage limits (Ask your data + briefing generation)
AI_ASK_PER_HOUR=20
AI_DAILY_CAP=300

# Encrypted database backups (scripts/backup-db.js). Store this passphrase in your password manager —
# without it a backup cannot be restored.
BACKUP_PASSPHRASE=
BACKUP_DIR=./backups

# LineLeader (ChildcareCRM) — enrollment/waitlist CRM. JWT auth via a read-only service account
# (LineLeader → Settings → Staff Settings → Service Accounts). AU host below; US = live.childcarecrm.com.
LINELEADER_BASE_URL=https://live.childcarecrm.com.au
LINELEADER_USERNAME=
LINELEADER_PASSWORD=

# ===== Feed health (/healthz) =====
# An unauthenticated endpoint for an external uptime monitor (UptimeRobot, Better Stack, Pingdom...).
# 200 when the feeds the board's figures rest on are arriving, 503 when they are not. The monitor does
# the pushing, which is the point: polled from outside, it also catches the case this app can never
# report on itself — that it is down, or its nightly job never ran.
#
# DO NOT point Render's own healthCheckPath at /healthz. Render restarts a service that fails its health
# check, and a stale OWNA feed is not a reason to restart the web server — it would restart it every few
# minutes and fix nothing.
#
# Optional. Set a long random value to require ?token=<value>; unset, the endpoint is open, which is what
# most monitors need. It reports statuses, ages and counts only — never an upstream error message.
HEALTHZ_TOKEN=
# Hours without a successful pull before a feed counts as stale. The snapshot runs nightly, so one missed
# night is about 26 hours. Deliberately not 24: a slow run finishing at 03:00 must not alarm every day.
HEALTH_STALE_HOURS=26

# Employment Hero Payroll (KeyPay) — labour hours + wage cost by centre. Basic auth (key as username,
# blank password). Read at call time (services/eh.js), so rotating the key here or in the Render
# dashboard takes effect on the next request — no restart needed.
#
# This is the PAYROLL API at api.yourpayroll.com.au. It is NOT the Employment Hero HR API at
# oauth.employmenthero.com, and the HR API's 30 September 2026 PKCE cutover does not apply to it:
# Basic auth with the API key remains supported here. Confirmed by the owner, 21 September 2026.
# There is deliberately no OAuth, access token or refresh token in this path — do not add one without
# a reason that is not the HR cutover.
EH_PAYROLL_BASE_URL=https://api.yourpayroll.com.au
EH_PAYROLL_API_KEY=
EH_PAYROLL_BUSINESS_ID=
EH_LABOUR_WEEKS=16

# Staff survey (eNPS) — sending the invitations from a real Futuro mailbox through Microsoft Graph.
# Leave these blank and the admin page falls back to the mail-merge CSV export, saying which variable
# is missing: nothing is blocked on configuration. The tenant side is an Entra app registration with
# the Mail.Send APPLICATION permission, a tenant admin's consent, and an Exchange RBAC for
# Applications role assignment scoping the app to GRAPH_SENDER alone — Mail.Send unscoped is every
# mailbox in the tenant. Sending as any other address then returns 403 by design.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
# Treat like a password. Never logged, never rendered, never stored. Entra secrets expire on a date.
GRAPH_CLIENT_SECRET=
# The mailbox invitations are sent FROM — must be the one the RBAC scope covers.
GRAPH_SENDER=
# The previous name for GRAPH_SENDER, still read so an existing deployment keeps sending. Leave unset.
# SURVEY_FROM_MAILBOX=
